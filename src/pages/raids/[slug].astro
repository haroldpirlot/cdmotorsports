---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RaidHero from '../../components/raid/RaidHero.astro';
import RaidIntro from '../../components/raid/RaidIntro.astro';
import RaidMap from '../../components/raid/RaidMap.astro';
import RaidItinerary from '../../components/raid/RaidItinerary.astro';
import IncludedExcluded from '../../components/raid/IncludedExcluded.astro';
import RaidGallery from '../../components/raid/RaidGallery.astro';
import RaidBike from '../../components/raid/RaidBike.astro';
import RaidCTA from '../../components/raid/RaidCTA.astro';
import RaidNav from '../../components/raid/RaidNav.astro';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const raids = await getCollection('raids');
  const sorted = raids.sort((a, b) => a.data.n - b.data.n);
  return sorted.map((raid, i) => ({
    params: { slug: raid.id },
    props: {
      raid,
      prev: sorted[(i - 1 + sorted.length) % sorted.length],
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { raid, prev, next } = Astro.props;
const totalKm = raid.data.stages.reduce((sum, s) => sum + s.km, 0);
const { Content } = await render(raid);

const title = `${raid.data.name} — ${raid.data.itin} · CDMotorSport`;
const description = `${raid.data.days} jours de raid moto au Maroc, ${totalKm} km au guidon d'une KOVE 450 Rally. Niveau ${raid.data.level}.`;
const raidUrl = new URL(`/raids/${raid.id}`, SITE.url).href;
const heroAbs = new URL(raid.data.hero, SITE.url).href;

// JSON-LD TouristTrip : itinerary structuré pour rich results Google
const touristTripJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: raid.data.name,
  description,
  url: raidUrl,
  image: heroAbs,
  touristType: raid.data.level,
  itinerary: {
    '@type': 'ItemList',
    numberOfItems: raid.data.stages.length,
    itemListElement: raid.data.stages.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Place',
        name: `${s.from} → ${s.to}`,
        description: `Jour ${i + 1} · ${s.km} km · Hébergement : ${s.lodging}`,
      },
    })),
  },
  provider: {
    '@type': 'TravelAgency',
    name: SITE.name,
    url: SITE.url,
  },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    url: new URL('/reserver', SITE.url).href,
    priceSpecification: {
      '@type': 'PriceSpecification',
      description: 'Prix sur demande',
    },
  },
};
---
<Layout title={title} description={description} ogImage={raid.data.hero}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(touristTripJsonLd)} />
  <RaidHero
    n={raid.data.n}
    name={raid.data.name}
    itin={raid.data.itin}
    days={raid.data.days}
    level={raid.data.level}
    hero={raid.data.hero}
    totalKm={totalKm}
  />
  <RaidIntro totalKm={totalKm} highlights={raid.data.highlights}>
    <Content />
  </RaidIntro>
  <RaidMap map={raid.data.map} name={raid.data.name} />
  <RaidItinerary stages={raid.data.stages} />
  <IncludedExcluded />
  <RaidGallery gallery={raid.data.gallery} name={raid.data.name} />
  <RaidBike />
  <RaidCTA />
  <RaidNav
    prev={{ slug: prev.id, name: prev.data.name }}
    next={{ slug: next.id, name: next.data.name }}
  />
</Layout>
