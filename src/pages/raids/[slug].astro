---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RaidHero from '../../components/raid/RaidHero.astro';
import RaidIntro from '../../components/raid/RaidIntro.astro';
import RaidMap from '../../components/raid/RaidMap.astro';
import RaidItinerary from '../../components/raid/RaidItinerary.astro';
import IncludedExcluded from '../../components/raid/IncludedExcluded.astro';
import RaidGallery from '../../components/raid/RaidGallery.astro';
import RaidBike from '../../components/raid/RaidBike.astro';
import RaidCTA from '../../components/raid/RaidCTA.astro';
import RaidNav from '../../components/raid/RaidNav.astro';

export async function getStaticPaths() {
  const raids = await getCollection('raids');
  const sorted = raids.sort((a, b) => a.data.n - b.data.n);
  return sorted.map((raid, i) => ({
    params: { slug: raid.id },
    props: {
      raid,
      prev: sorted[(i - 1 + sorted.length) % sorted.length],
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { raid, prev, next } = Astro.props;
const totalKm = raid.data.stages.reduce((sum, s) => sum + s.km, 0);
const { Content } = await render(raid);

const title = `${raid.data.name} — ${raid.data.itin} · CDMotorsports`;
const description = `${raid.data.days} jours de raid moto au Maroc, ${totalKm} km au guidon d'une KOVE 450 Rally. Niveau ${raid.data.level}.`;
---
<Layout title={title} description={description}>
  <RaidHero
    n={raid.data.n}
    name={raid.data.name}
    itin={raid.data.itin}
    days={raid.data.days}
    level={raid.data.level}
    hero={raid.data.hero}
    totalKm={totalKm}
  />
  <RaidIntro totalKm={totalKm} highlights={raid.data.highlights}>
    <Content />
  </RaidIntro>
  <RaidMap map={raid.data.map} name={raid.data.name} />
  <RaidItinerary stages={raid.data.stages} />
  <IncludedExcluded />
  <RaidGallery gallery={raid.data.gallery} name={raid.data.name} />
  <RaidBike />
  <RaidCTA />
  <RaidNav
    prev={{ slug: prev.id, name: prev.data.name }}
    next={{ slug: next.id, name: next.data.name }}
  />
</Layout>
