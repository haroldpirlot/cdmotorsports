---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../config';

const lang = 'en';
const entry = await getEntry('pagesEn', 'edouard-de-moor');
if (!entry) throw new Error('Missing singleton content: pages-en/edouard-de-moor');
const data = entry.data;

const layout = [
  's6 r2', 's3', 's3',
  's3', 's3', 's6',
  's4', 's4', 's4',
  's6', 's3', 's3',
];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Edouard Charles De Moor',
  givenName: 'Edouard Charles',
  familyName: 'De Moor',
  jobTitle: data.jsonLd.jobTitle,
  nationality: data.jsonLd.nationality,
  url: new URL('/en/edouard-de-moor', SITE.url).href,
  image: new URL(data.heroPhoto, SITE.url).href,
  knowsAbout: data.jsonLd.knowsAbout,
  worksFor: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  subjectOf: data.press.map((a) => ({
    '@type': 'NewsArticle',
    headline: a.title,
    url: a.url,
    datePublished: a.datePublished,
    inLanguage: data.jsonLd.inLanguage,
    image: new URL(`${a.image}.jpg`, SITE.url).href,
    about: { '@type': 'Person', name: 'Edouard Charles De Moor' },
    publisher: {
      '@type': 'NewsMediaOrganization',
      name: a.source,
      url: a.publisherUrl,
    },
  })),
};
---
<Layout
  title={data.seoTitle}
  description={data.seoDescription}
  ogImage={data.heroPhoto}
  lang={lang}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <section class="phero" style={`background-image:url('${data.heroPhoto}')`}>
    <div class="wrap c">
      <div class="eyebrow" style="color:#e8c9a6">{data.heroEyebrow}</div>
      <h1 set:html={data.heroTitle}></h1>
    </div>
  </section>

  {data.sections.map((s) => (
    <section class="pad">
      <div class="wrap article">
        <div class="meta reveal">{s.meta}</div>
        <div class="big reveal" style="margin-bottom:26px" set:html={s.bigTitle}></div>
        <div class="reveal">
          {s.paragraphs.map((p) => (
            <p set:html={p}></p>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="pad press-section">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:32px">
        <div class="eyebrow" style="margin-bottom:16px">{data.pressEyebrow}</div>
        <div class="big" style="font-size:clamp(24px,3vw,36px)" set:html={data.pressTitle}></div>
      </div>
      <div class="press-list reveal">
        {data.press.map((a) => (
          <a
            class="press-card"
            href={a.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${a.title}, ${a.source}, ${a.date} ${data.pressAriaNewTab}`}
          >
            <div class="press-cover">
              <img
                src={`${a.image}.jpg`}
                srcset={`${a.image}-800.jpg 800w, ${a.image}.jpg 1200w`}
                sizes="(max-width: 720px) 100vw, (max-width: 960px) 50vw, 33vw"
                alt={a.imageAlt}
                loading="lazy"
                decoding="async"
              />
              {a.credit && <span class="press-credit">{a.credit}</span>}
            </div>
            <div class="press-body">
              <div class="press-meta">
                <span class="press-source">{a.source}</span>
                <span class="press-sep">·</span>
                <span class="press-date">{a.date}</span>
              </div>
              <h3 class="press-title">« {a.title} »</h3>
              <span class="press-arrow" aria-hidden="true">
                {data.pressReadLabel}
                <svg viewBox="0 0 16 16" width="14" height="14">
                  <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M6 3 L11 8 L6 13 M3.5 8 L11 8"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
      {data.pressFooterNote && (
        <p style="margin-top:14px;color:#6b6255;font-size:13px;font-style:italic">
          {data.pressFooterNote}
        </p>
      )}
    </div>
  </section>

  <section class="gal pad">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:40px">
        <div class="eyebrow" style="margin-bottom:16px">{data.galleryEyebrow}</div>
        <div class="big" set:html={data.galleryTitle}></div>
      </div>
      <div class="ggrid reveal">
        {data.galleryPhotos.map((src, i) => (
          <a class={layout[i] ?? 's4'} href={src} aria-label={data.galleryAriaPrefix.replace('{n}', String(i + 2))}>
            <img src={src} alt={`${data.galleryAltPrefix} ${i + 2}`} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .press-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    @media (max-width: 960px) {
      .press-list { grid-template-columns: repeat(2, 1fr); }
    }
    .press-card {
      display: flex;
      flex-direction: column;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 3px;
      color: var(--ink);
      text-decoration: none;
      overflow: hidden;
      transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
    }
    .press-card:hover {
      border-color: var(--sand);
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(20, 16, 8, .06);
    }
    .press-cover {
      position: relative;
      overflow: hidden;
      aspect-ratio: 16 / 10;
      background: var(--cream);
    }
    .press-cover img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .5s cubic-bezier(.5, 0, .2, 1);
    }
    .press-card:hover .press-cover img { transform: scale(1.04); }
    .press-body {
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding: 22px 26px 22px;
      flex: 1;
    }
    .press-meta {
      display: flex;
      gap: 8px;
      align-items: center;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 600;
    }
    .press-source { color: var(--sand); }
    .press-sep { opacity: .5; }
    .press-title {
      font-family: var(--disp);
      font-weight: 700;
      font-size: clamp(17px, 1.6vw, 20px);
      line-height: 1.35;
      color: var(--ink);
      margin: 0;
      letter-spacing: -.2px;
    }
    .press-arrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: var(--sand);
      font-weight: 700;
      margin-top: auto;
    }
    .press-arrow svg { transition: transform .25s ease; }
    .press-card:hover .press-arrow svg { transform: translateX(3px); }

    .press-credit {
      position: absolute;
      right: 8px;
      bottom: 8px;
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: .5px;
      color: #fff;
      background: rgba(0, 0, 0, .55);
      padding: 3px 8px;
      border-radius: 2px;
      line-height: 1.4;
      pointer-events: none;
    }

    @media (max-width: 720px) {
      .press-list { grid-template-columns: 1fr; gap: 22px; }
    }
  </style>

  <section class="cta pad">
    <div class="bg" style={`background-image:url('${data.heroPhoto}')`}></div>
    <div class="wrap reveal">
      <div class="eyebrow" style="color:#e8c9a6;margin-bottom:16px">{data.ctaEyebrow}</div>
      <div class="big" set:html={data.ctaTitle}></div>
      <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:24px">
        {data.ctaButtons.map((b) => (
          <a href={b.href} class="btn">{b.label}</a>
        ))}
      </div>
    </div>
  </section>
</Layout>
