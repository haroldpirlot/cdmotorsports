---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../config';
import { getCollection } from 'astro:content';
import { t, pathTo } from '../../i18n';

const lang = 'en';
const T = t(lang);
const raids = (await getCollection('raidsEn')).sort((a, b) => a.data.n - b.data.n);
const submitted = Astro.url.searchParams.get('ok') === '1';

const formAction = `https://formspree.io/f/${SITE.formspreeId}`;
const nextUrl = `${SITE.url}/en/reserver?ok=1`;
---
<Layout title={T.meta.book.title} description={T.meta.book.description} lang={lang}>
  <section class="phero short" style="background-image:url('/img/pin.jpg')">
    <div class="wrap c">
      <div class="eyebrow" style="color:#e8c9a6">{T.reserver.heroEyebrow}</div>
      <h1>{T.reserver.heroH1Start} <em>{T.reserver.heroH1Em}</em></h1>
    </div>
  </section>

  <section class="pad">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:36px">
        <div class="eyebrow" style="margin-bottom:16px">How it works</div>
        <div class="big">From interest to <em>start line</em></div>
      </div>
      <div class="steps reveal" style="margin-bottom:56px">
        {T.reserver.steps.map((s) => (
          <div class="step">
            <b>{s.n}</b>
            <span>{s.h}</span>
            <small>{s.p}</small>
          </div>
        ))}
      </div>

      <div class="formwrap">
        <div class="reveal">
          {submitted && (
            <div class="note" style="border-left-color:var(--check);margin-bottom:20px;background:#f0f7f2;color:#3F7A57">
              <b>{T.reserver.successTitle}</b> {T.reserver.successBody}
            </div>
          )}
          <form action={formAction} method="POST">
            <input type="hidden" name="_subject" value="New booking enquiry, CDM Motorsport" />
            <input type="hidden" name="_next" value={nextUrl} />
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-5000px" aria-hidden="true" />

            <div class="row2">
              <div class="field">
                <label for="f-name">{T.reserver.labels.name}</label>
                <input id="f-name" name="name" placeholder={T.reserver.placeholders.name} required />
              </div>
              <div class="field">
                <label for="f-email">{T.reserver.labels.email}</label>
                <input id="f-email" name="email" type="email" placeholder={T.reserver.placeholders.email} required />
              </div>
            </div>

            <div class="row2">
              <div class="field">
                <label for="f-raid">{T.reserver.labels.raid}</label>
                <select id="f-raid" name="raid">
                  {raids.map((r) => <option value={r.data.name}>{r.data.name}</option>)}
                  <option value="undecided">{T.reserver.selectRaidDefault}</option>
                </select>
              </div>
              <div class="field">
                <label for="f-level">{T.reserver.labels.level}</label>
                <select id="f-level" name="level">
                  <option>{T.reserver.levels.beginner}</option>
                  <option>{T.reserver.levels.intermediate}</option>
                  <option>{T.reserver.levels.confirmed}</option>
                </select>
              </div>
            </div>

            <div class="row2">
              <div class="field">
                <label for="f-dates">{T.reserver.labels.dates}</label>
                <input id="f-dates" name="dates" placeholder={T.reserver.placeholders.dates} />
              </div>
              <div class="field">
                <label for="f-pilotes">Number of riders</label>
                <input id="f-pilotes" name="riders" type="number" min="1" placeholder="1" />
              </div>
            </div>

            <div class="field">
              <label for="f-msg">{T.reserver.labels.message}</label>
              <textarea id="f-msg" name="message" placeholder={T.reserver.placeholders.message}></textarea>
            </div>

            <button type="submit" class="btn">{T.reserver.submit}</button>
          </form>
        </div>

        <div class="cinfo reveal">
          <div class="eyebrow" style="margin-bottom:14px">{T.reserver.alternativeTitle}</div>
          <div class="line"><b>WhatsApp</b><span>{SITE.contact.phone}</span></div>
          <div class="line"><b>Email</b><span><a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a></span></div>
          <div class="line"><b>Departures</b><span>From Agadir, Morocco</span></div>
          <div class="line"><b>Socials</b><span><a href={SITE.contact.instagramUrl} target="_blank" rel="noopener">{SITE.contact.instagram}</a></span></div>
          <a href={SITE.whatsappUrl} class="btn wa wide" style="margin-top:20px" target="_blank" rel="noopener">
            <svg class="btn-icon" viewBox="0 0 32 32" aria-hidden="true">
              <path fill="currentColor" d="M16.02 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.26.6 4.46 1.72 6.4L3.2 28.8l6.56-1.72a12.72 12.72 0 0 0 6.26 1.62h.02c7.06 0 12.8-5.74 12.8-12.8 0-3.42-1.34-6.62-3.76-9.04A12.7 12.7 0 0 0 16.02 3.2Zm0 23.4h-.02a10.6 10.6 0 0 1-5.4-1.48l-.38-.22-3.9 1.02 1.04-3.8-.24-.4a10.6 10.6 0 0 1-1.62-5.62c0-5.86 4.76-10.62 10.62-10.62 2.84 0 5.5 1.1 7.5 3.12a10.6 10.6 0 0 1 3.12 7.5c0 5.86-4.76 10.62-10.62 10.62Zm5.82-7.94c-.32-.16-1.88-.92-2.18-1.02-.3-.1-.5-.16-.72.16-.22.32-.82 1.02-1 1.24-.18.22-.36.24-.68.08-.32-.16-1.34-.5-2.56-1.58a9.62 9.62 0 0 1-1.78-2.2c-.18-.32-.02-.5.14-.66.14-.14.32-.36.48-.54.16-.18.22-.32.34-.54.1-.22.06-.4-.02-.56-.08-.16-.72-1.72-.98-2.36-.26-.62-.52-.54-.72-.54H10.8c-.2 0-.54.08-.82.4-.28.32-1.08 1.06-1.08 2.58 0 1.52 1.1 2.98 1.26 3.2.16.22 2.18 3.32 5.28 4.66.74.32 1.32.5 1.76.66.74.24 1.42.2 1.96.12.6-.08 1.88-.76 2.14-1.5.26-.74.26-1.36.18-1.5-.08-.14-.28-.22-.6-.38Z"/>
            </svg>
            Message on WhatsApp
          </a>
          <p style="margin-top:18px;color:#6b6255;font-size:13px">
            Our seasons fill up several months in advance — don't wait too long.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
