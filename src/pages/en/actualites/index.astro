---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const lang = 'en';
const posts = (await getCollection('blogEn')).sort((a, b) => a.data.order - b.data.order);
---
<Layout
  title="Blog, advice, stories & behind the scenes · CDM Motorsport"
  description="Advice, stories and behind-the-scenes: everything to prepare for your motorcycle rally-raid tour in Morocco and extend the adventure."
  lang={lang}
>
  <section class="phero" style="background-image:url('/img/band.jpg')">
    <div class="wrap c">
      <div class="eyebrow" style="color:#e8c9a6">The blog</div>
      <h1>The <em>blog</em></h1>
    </div>
  </section>

  <section class="pad">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:40px">
        <div class="eyebrow" style="margin-bottom:16px">The blog</div>
        <div class="big">Advice, stories<br />&amp; <em>behind the scenes.</em></div>
        <p class="lead" style="margin-top:16px">
          Everything you need to prepare for your raid and extend the adventure.
        </p>
      </div>
      <div class="grid3">
        {posts.map((p) => (
          <a class="pcard reveal" href={`/en/actualites/${p.id}`}>
            <div class="ph"><img src={p.data.hero} alt={p.data.cardTitle} loading="lazy" /></div>
            <div class="b">
              <div class="tag">{p.data.cardTag}</div>
              <h3>{p.data.cardTitle}</h3>
              <p>{p.data.cardExcerpt}</p>
              <span class="more">Read the article →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  a.pcard {
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform .3s ease, box-shadow .3s ease;
  }
  a.pcard:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, .12);
  }
  a.pcard .b .more {
    display: inline-block;
    margin-top: auto;
    font-family: var(--disp);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 12px;
    color: var(--sand);
    padding-top: 8px;
  }
</style>
