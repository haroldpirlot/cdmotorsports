---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Boutique — Coming soon · CDMotorSport"
  description="Textile et équipement CDMotorSport — pour rouler et porter l'aventure au quotidien. Ouverture prochaine."
>
  <section class="phero short" style="background-image:url('/img/g5.jpg')">
    <div class="wrap c">
      <div class="eyebrow" style="color:#e8c9a6">Boutique</div>
      <h1>La <em>boutique</em></h1>
    </div>
  </section>

  <section class="pad">
    <div class="wrap" style="text-align:center;max-width:720px">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:16px">Boutique</div>
        <div class="big">La boutique <em>arrive.</em></div>
        <p class="lead" style="margin:18px auto 26px">
          Textile et équipement aux couleurs de CDMotorSport — pour rouler et porter l'aventure au quotidien.
          Ouverture prochaine.
        </p>
        <span style="display:inline-block;font-family:var(--disp);text-transform:uppercase;letter-spacing:3px;font-size:13px;color:#fff;background:var(--sand);padding:12px 26px;border-radius:2px">
          Coming soon
        </span>
        <p style="margin-top:26px;color:#6b6255;font-size:14px">
          Envie d'être prévenu du lancement ? <a href="/reserver" style="color:var(--sand)">Écrivez-nous</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
