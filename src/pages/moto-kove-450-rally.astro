---
import Layout from '../layouts/Layout.astro';

const specs = [
  { label: 'Cylindrée',     value: '450 cc' },
  { label: 'Poids',         value: '~140 kg' },
  { label: 'Autonomie',     value: 'Grand réservoir longue distance' },
  { label: 'Suspensions',   value: 'Débattement rally' },
  { label: 'Navigation',    value: 'Tour de road-book / GPS' },
  { label: 'Profil',        value: 'Rally-raid tout-terrain' },
];

const features = [
  { n: '01', h: 'Légèreté',    p: 'Maniable dans le sable comme sur la roche, elle pardonne et met en confiance.' },
  { n: '02', h: 'Fiabilité',   p: 'Entretenue et préparée avec le même soin que pour la course.' },
  { n: '03', h: 'Autonomie',   p: 'Un réservoir taillé pour les longues étapes loin de tout.' },
  { n: '04', h: 'Esprit rally', p: 'Tour de navigation, position de conduite et débattement dignes du rallye-raid.' },
];
---
<Layout
  title="La Moto — KOVE 450 Rally · CDMotorSport"
  description="La KOVE 450 Rally : une véritable machine de rallye-raid, légère, fiable et taillée pour les longues pistes du désert marocain."
>
  <section class="phero" style="background-image:url('/img/g9.jpg')">
    <div class="wrap c">
      <div class="eyebrow" style="color:#e8c9a6">La moto</div>
      <h1>KOVE 450 <em>Rally</em></h1>
    </div>
  </section>

  <section class="pad">
    <div class="wrap two">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:16px">La machine</div>
        <div class="big">Née pour le <em>rally.</em></div>
        <p class="lead" style="margin-top:18px">
          La KOVE 450 Rally est une moto d'exception qui s'exprime à merveille dans les grands espaces :
          légère, fiable et taillée pour les longues pistes du désert.
        </p>
        <ul class="specs">
          {specs.map((s) => (
            <li><span>{s.label}</span><b>{s.value}</b></li>
          ))}
        </ul>
        <a href="/reserver" class="btn dark" style="margin-top:22px">Réserver un raid</a>
      </div>
      <div class="reveal">
        <img src="/img/g9.jpg" alt="KOVE 450 Rally" style="aspect-ratio:4/5" />
      </div>
    </div>
  </section>

  <section class="pad" style="background:var(--cream)">
    <div class="wrap">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:16px">Pourquoi la KOVE</div>
        <div class="big">Préparée comme<br />en <em>compétition.</em></div>
      </div>
      <div class="feat reveal">
        {features.map((f) => (
          <div class="it">
            <div class="n">{f.n}</div>
            <h4>{f.h}</h4>
            <p>{f.p}</p>
          </div>
        ))}
      </div>
      <div class="note reveal" style="margin-top:30px">
        Partenariat KOVE — logo et visuels officiels à intégrer. Motos fournies et préparées par CDMotorSport.
      </div>
    </div>
  </section>
</Layout>
