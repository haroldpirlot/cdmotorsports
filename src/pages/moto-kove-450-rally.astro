---
import Layout from '../layouts/Layout.astro';

const specs = [
  'Échappement en inox',
  'Moteur double arbre à cames alliant performance et entretien peu contraignant',
  'Sabot moteur en carbone',
  'Amortisseur de couple',
  'Compteur numérique contrôlable via les boutons au guidon, avec tour de navigation en PA',
  'ABS déconnectable',
  'Fourche Factory 49 mm entièrement réglable',
  'Amortisseur 300 mm de débattement (version haute), entièrement réglable',
  'Filtre à air Factory accessible en 2 secondes',
  'Radiateurs gros volume avec ventilation',
  "Radiateur d'huile avec protection carbone",
  'Éclairage LED',
  "Autonomie d'environ 550 km",
  'ECU Bosch',
];

const highlights = [
  { label: 'Réservoirs',   value: '3 réservoirs, 30 L de carburant' },
  { label: 'Autonomie',    value: '~550 km' },
  { label: 'Navigation',   value: 'Tour de navigation / GPS' },
  { label: 'Profil',       value: 'Rally-raid tout-terrain' },
];
---
<Layout
  title="La Moto, KOVE 450 Rally · CDM Motorsport"
  description="La KOVE 450 Rally Standard : machine légère, endurante, issue de la compétition. 3 réservoirs, 30 L, autonomie ~550 km, taillée pour tous les terrains."
>
  <section class="phero" style="background-image:url('/img/gallery/gallery-07.jpg')">
    <div class="wrap c">
      <div class="eyebrow" style="color:#e8c9a6">La moto</div>
      <h1>KOVE 450 <em>Rally</em></h1>
    </div>
  </section>

  <section class="pad">
    <div class="wrap two">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:16px">La machine</div>
        <div class="big">Née pour le <em>rally.</em></div>
        <p class="lead" style="margin-top:22px">
          La KOVE 450 Rally Standard incarne l'essence même des motos rallye développées par
          <a href="https://kove-racing.com/" target="_blank" rel="noopener" class="ext">KOVE Racing</a>
          : une machine légère, endurante et directement issue de l'expérience compétition de la marque.
        </p>
        <p style="margin-top:14px">
          La 450 Rally Standard repose sur une base technique éprouvée, pensée pour offrir un équilibre
          optimal entre performance tout-terrain, autonomie et facilité d'utilisation, aussi bien pour
          le voyage que pour l'engagement sportif.
        </p>
        <p style="margin-top:14px">
          Équipée de <b>3 réservoirs</b> pour une contenance totale de <b>30 L</b> de carburant.
          Taillée pour affronter tous types de terrains.
        </p>
        <ul class="specs">
          {highlights.map((s) => (
            <li><span>{s.label}</span><b>{s.value}</b></li>
          ))}
        </ul>
        <a href="/reserver" class="btn dark" style="margin-top:26px">Réserver un raid</a>
      </div>
      <div class="reveal">
        <img src="/img/gallery/gallery-13.jpg" alt="KOVE 450 Rally" style="aspect-ratio:4/5" />
      </div>
    </div>
  </section>

  <section class="pad" style="background:var(--cream)">
    <div class="wrap">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:16px">Caractéristiques techniques</div>
        <div class="big">Préparée comme<br />en <em>compétition.</em></div>
      </div>
      <ul class="speclist reveal">
        {specs.map((s) => <li>{s}</li>)}
      </ul>
      <p class="note reveal" style="margin-top:36px;font-style:italic">
        Cette machine est conçue pour affronter les pistes avec CDM Motorsport.
      </p>
    </div>
  </section>
</Layout>

<style>
  .ext {
    color: var(--sand);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .ext:hover { color: var(--ink); }

  .speclist {
    list-style: none;
    padding: 0;
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .speclist li {
    padding: 16px 8px 16px 26px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.5;
    color: #4c4438;
    position: relative;
  }
  .speclist li::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 24px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sand);
  }
  @media (max-width: 720px) {
    .speclist { grid-template-columns: 1fr; }
  }
</style>
