---
import Layout from '../../layouts/Layout.astro';

const articles = [
  { img: '/img/g10.jpg',    tag: 'Conseils',    title: 'Préparer son premier raid enduro au Maroc', excerpt: "Niveau, équipement, condition physique : nos conseils pour aborder sereinement votre première aventure.", href: '/actualites/preparer-son-premier-raid' },
  { img: '/img/apropos.jpg', tag: 'Pratique',    title: 'Venir rouler avec sa propre moto',           excerpt: 'Assistance 4×4, transport des bagages et formalités : comment participer avec votre machine.', href: '#' },
  { img: '/img/village.jpg', tag: 'Destination', title: '5 raisons de rouler dans le Sud marocain',    excerpt: 'Diversité des terrains, météo, accueil : pourquoi le Maroc est la destination raid par excellence.', href: '#' },
  { img: '/img/g5.jpg',      tag: 'Matériel',    title: "Le KOVE 450 Rally à l'épreuve des dunes",     excerpt: 'Retour de terrain sur la moto qui équipe nos raids.', href: '#' },
  { img: '/img/team.jpg',    tag: 'Presse',      title: 'CDMotorSport dans la presse',                 excerpt: 'Nos raids et nos images vus par les médias moto. (Page presse & médias.)', href: '#' },
  { img: '/img/g6.jpg',      tag: 'Conseils',    title: 'Bien gérer sa condition physique en raid',    excerpt: "Hydratation, récupération, alimentation : rouler plusieurs jours d'affilée.", href: '#' },
];
---
<Layout
  title="Actualités & Conseils — Le blog · CDMotorSport"
  description="Conseils, récits et coulisses : tout pour préparer votre raid moto au Maroc et prolonger l'aventure."
>
  <section class="phero" style="background-image:url('/img/band.jpg')">
    <div class="wrap c">
      <div class="eyebrow" style="color:#e8c9a6">Le blog</div>
      <h1>Actualités &amp; <em>Conseils</em></h1>
    </div>
  </section>

  <section class="pad">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:40px">
        <div class="eyebrow" style="margin-bottom:16px">Le blog</div>
        <div class="big">Conseils, récits<br />&amp; <em>coulisses.</em></div>
        <p class="lead" style="margin-top:16px">
          Tout pour préparer votre raid et prolonger l'aventure. (Articles d'exemple — à rédiger.)
        </p>
      </div>
      <div class="grid3">
        {articles.map((a) => (
          <div class="pcard reveal">
            <div class="ph"><img src={a.img} alt={a.title} /></div>
            <div class="b">
              <div class="tag">{a.tag}</div>
              <h3>{a.title}</h3>
              <p>{a.excerpt}</p>
              <a class="more" href={a.href}>Lire l'article →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
