---
import Layout from '../../layouts/Layout.astro';

const articles = [
  {
    img: '/img/gallery/gallery-05.jpg',
    tag: 'Conseils',
    title: 'Préparer son premier raid moto au Maroc',
    excerpt: "Expérience, forme, équipement, navigation : ce qu'il faut vraiment savoir avant de se lancer sur un premier raid.",
    href: '/actualites/preparer-son-premier-raid',
  },
  {
    img: '/img/gallery/gallery-13.jpg',
    tag: 'Pratique',
    title: "Venir rouler au Maroc avec sa propre moto",
    excerpt: "Transport, formalités, assurances et assistance : comment participer à un raid avec ta propre machine.",
    href: '/actualites/venir-avec-sa-propre-moto',
  },
  {
    img: '/img/village.jpg',
    tag: 'Destination',
    title: 'Pourquoi le Sud marocain est mon terrain de jeu',
    excerpt: "Diversité des terrains, héritage du Dakar, climat idéal, hospitalité : pourquoi j'ai choisi le Sud du Maroc.",
    href: '/actualites/sud-marocain-paradis-rallye-raid',
  },
  {
    img: '/img/gallery/gallery-07.jpg',
    tag: 'Matériel',
    title: "La KOVE 450 Rally : pourquoi je l'ai choisie",
    excerpt: "Vraie machine de rallye, trois réservoirs, autonomie généreuse : pourquoi la KOVE 450 Rally est ma monture.",
    href: '/actualites/kove-450-rally-accessible',
  },
  {
    img: '/img/gallery/gallery-15.jpg',
    tag: 'Technique',
    title: 'La navigation : trouver son chemin dans le désert',
    excerpt: "Trace GPS et lecture du terrain : comment s'orienter en rallye-raid sans dépendre uniquement de l'écran.",
    href: '/actualites/navigation-rallye-raid',
  },
  {
    img: '/img/gallery/gallery-04.jpg',
    tag: 'Conseils',
    title: 'Se préparer physiquement pour un raid moto',
    excerpt: "Cardio, renforcement, hydratation, récupération : comment se préparer sans se compliquer la vie.",
    href: '/actualites/preparation-physique-raid',
  },
];
---
<Layout
  title="Blog, Conseils, récits & coulisses · CDM Motorsport"
  description="Conseils, récits et coulisses : tout pour préparer votre raid moto au Maroc et prolonger l'aventure."
>
  <section class="phero" style="background-image:url('/img/band.jpg')">
    <div class="wrap c">
      <div class="eyebrow" style="color:#e8c9a6">Le blog</div>
      <h1>Le <em>blog</em></h1>
    </div>
  </section>

  <section class="pad">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:40px">
        <div class="eyebrow" style="margin-bottom:16px">Le blog</div>
        <div class="big">Conseils, récits<br />&amp; <em>coulisses.</em></div>
        <p class="lead" style="margin-top:16px">
          Tout pour préparer votre raid et prolonger l'aventure.
        </p>
      </div>
      <div class="grid3">
        {articles.map((a) => (
          <a class="pcard reveal" href={a.href}>
            <div class="ph"><img src={a.img} alt={a.title} loading="lazy" /></div>
            <div class="b">
              <div class="tag">{a.tag}</div>
              <h3>{a.title}</h3>
              <p>{a.excerpt}</p>
              <span class="more">Lire l'article →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  a.pcard {
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform .3s ease, box-shadow .3s ease;
  }
  a.pcard:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, .12);
  }
  a.pcard .b .more {
    display: inline-block;
    margin-top: auto;
    font-family: var(--disp);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 12px;
    color: var(--sand);
    padding-top: 8px;
  }
</style>
