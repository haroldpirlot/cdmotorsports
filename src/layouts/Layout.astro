---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/sections.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
}
const {
  title = 'CDM Motorsport, Every ride tells a story',
  description = 'Raids moto (rallye-raid) au Maroc en KOVE 450 Rally. Live the rally. Ride the legend.',
  ogImage = '/img/og-cover.png',
  lang = 'fr',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageAbs = new URL(ogImage, SITE.url).href;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/img/hero.jpg', SITE.url).href,
  image: ogImageAbs,
  description: SITE.description,
  slogan: SITE.tagline,
  areaServed: { '@type': 'Country', name: 'Maroc' },
  knowsLanguage: ['fr', 'en'],
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />

  <link rel="preload" href="/fonts/clash-display-600.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />

  <!-- JSON-LD : identité de l'organisation, présent sur toutes les pages -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

  <!-- slot pour JSON-LD spécifique à la page (TouristTrip, FAQPage, etc.) -->
  <slot name="head" />

  {import.meta.env.PROD && SITE.gaId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
      <script is:inline define:vars={{ gaId: SITE.gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )}
</head>
<body>
  <CustomCursor />

  <div id="loader">
    <div class="l1" id="lw"></div>
    <div class="bar" id="lbar"></div>
  </div>

  <Header />

  <main>
    <slot />
  </main>

  <Footer />

  <FloatingActions />

  <div id="lb"><img src="" alt="" /></div>
</body>
</html>

<style is:global>
  /* loader */
  #loader {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: #141008;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }
  #loader .l1 {
    font-family: var(--disp);
    font-weight: 300;
    color: #fff;
    font-size: clamp(26px, 5vw, 54px);
    letter-spacing: .5px;
    overflow: hidden;
  }
  #loader .l1 span {
    display: inline-block;
    transform: translateY(110%);
    opacity: 0;
  }
  #loader .bar {
    width: 0;
    height: 1px;
    background: var(--sand);
    margin-top: 26px;
    transition: width 1.4s cubic-bezier(.7, 0, .2, 1);
  }
  body.loaded #loader {
    transform: translateY(-100%);
    transition: transform 1s cubic-bezier(.76, 0, .24, 1);
  }

  /* lightbox */
  #lb {
    position: fixed;
    inset: 0;
    z-index: 9500;
    background: rgba(8, 6, 3, .95);
    display: none;
    align-items: center;
    justify-content: center;
  }
  #lb img { max-width: 92vw; max-height: 90vh; }
</style>

<script>
  // loader word reveal
  (function () {
    const words = 'Every ride tells a story'.split(' ');
    const lw = document.getElementById('lw');
    const lbar = document.getElementById('lbar');
    if (lw) {
      lw.innerHTML = words.map((w) => '<span>' + w + '&nbsp;</span>').join('');
      const sp = lw.querySelectorAll('span');
      sp.forEach((s, i) => {
        s.animate(
          [
            { transform: 'translateY(110%)', opacity: 0 },
            { transform: 'translateY(0)', opacity: 1 },
          ],
          { duration: 600, delay: 200 + i * 140, fill: 'forwards', easing: 'cubic-bezier(.5,0,.2,1)' }
        );
      });
    }
    if (lbar) setTimeout(() => (lbar.style.width = '180px'), 150);

    let done = false;
    function start() {
      if (done) return;
      done = true;
      setTimeout(() => {
        document.body.classList.add('loaded');
        document.dispatchEvent(new CustomEvent('cdm:loaded'));
      }, 1600);
    }
    window.addEventListener('load', start);
    setTimeout(start, 2600);
  })();

  // reveal observer
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    }),
    { threshold: .15 }
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // parallax
  const px = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  addEventListener('scroll', () => {
    px.forEach((el) => {
      const parent = el.parentElement;
      if (!parent) return;
      const r = parent.getBoundingClientRect();
      const off = (r.top + r.height / 2 - innerHeight / 2) * -.12;
      el.style.transform = 'translateY(' + off + 'px) scale(1.12)';
    });
  }, { passive: true });

  // lightbox
  const lb = document.getElementById('lb');
  const lbi = lb?.querySelector('img');
  document.querySelectorAll<HTMLAnchorElement>('.ggrid a').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const img = a.querySelector('img');
      if (lb && lbi && img) {
        lbi.src = img.src;
        lb.style.display = 'flex';
      }
    });
  });
  lb?.addEventListener('click', () => (lb.style.display = 'none'));
</script>
