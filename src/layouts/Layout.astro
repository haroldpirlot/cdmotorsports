---
import '../styles/global.css';
import '../styles/sections.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}
const {
  title = 'CDMotorSport — Every ride tells a story',
  description = 'Raids moto (rallye-raid) au Maroc en KOVE 450 Rally. Live the rally. Ride the legend.',
  lang = 'fr',
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200;12..96,300;12..96,400;12..96,500;12..96,600&family=Hanken+Grotesk:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <CustomCursor />

  <div id="loader">
    <div class="l1" id="lw"></div>
    <div class="bar" id="lbar"></div>
  </div>

  <Header />

  <main>
    <slot />
  </main>

  <Footer />

  <div id="lb"><img src="" alt="" /></div>
</body>
</html>

<style is:global>
  /* loader */
  #loader {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: #141008;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }
  #loader .l1 {
    font-family: var(--disp);
    font-weight: 300;
    color: #fff;
    font-size: clamp(26px, 5vw, 54px);
    letter-spacing: .5px;
    overflow: hidden;
  }
  #loader .l1 span {
    display: inline-block;
    transform: translateY(110%);
    opacity: 0;
  }
  #loader .bar {
    width: 0;
    height: 1px;
    background: var(--sand);
    margin-top: 26px;
    transition: width 1.4s cubic-bezier(.7, 0, .2, 1);
  }
  body.loaded #loader {
    transform: translateY(-100%);
    transition: transform 1s cubic-bezier(.76, 0, .24, 1);
  }

  /* lightbox */
  #lb {
    position: fixed;
    inset: 0;
    z-index: 9500;
    background: rgba(8, 6, 3, .95);
    display: none;
    align-items: center;
    justify-content: center;
  }
  #lb img { max-width: 92vw; max-height: 90vh; }
</style>

<script>
  // loader word reveal
  (function () {
    const words = 'Every ride tells a story'.split(' ');
    const lw = document.getElementById('lw');
    const lbar = document.getElementById('lbar');
    if (lw) {
      lw.innerHTML = words.map((w) => '<span>' + w + '&nbsp;</span>').join('');
      const sp = lw.querySelectorAll('span');
      sp.forEach((s, i) => {
        s.animate(
          [
            { transform: 'translateY(110%)', opacity: 0 },
            { transform: 'translateY(0)', opacity: 1 },
          ],
          { duration: 600, delay: 200 + i * 140, fill: 'forwards', easing: 'cubic-bezier(.5,0,.2,1)' }
        );
      });
    }
    if (lbar) setTimeout(() => (lbar.style.width = '180px'), 150);

    let done = false;
    function start() {
      if (done) return;
      done = true;
      setTimeout(() => {
        document.body.classList.add('loaded');
        document.dispatchEvent(new CustomEvent('cdm:loaded'));
      }, 1600);
    }
    window.addEventListener('load', start);
    setTimeout(start, 2600);
  })();

  // reveal observer
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    }),
    { threshold: .15 }
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // parallax
  const px = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  addEventListener('scroll', () => {
    px.forEach((el) => {
      const parent = el.parentElement;
      if (!parent) return;
      const r = parent.getBoundingClientRect();
      const off = (r.top + r.height / 2 - innerHeight / 2) * -.12;
      el.style.transform = 'translateY(' + off + 'px) scale(1.12)';
    });
  }, { passive: true });

  // lightbox
  const lb = document.getElementById('lb');
  const lbi = lb?.querySelector('img');
  document.querySelectorAll<HTMLAnchorElement>('.ggrid a').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const img = a.querySelector('img');
      if (lb && lbi && img) {
        lbi.src = img.src;
        lb.style.display = 'flex';
      }
    });
  });
  lb?.addEventListener('click', () => (lb.style.display = 'none'));
</script>
