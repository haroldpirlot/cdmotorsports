---
import '../styles/global.css';
import '../styles/sections.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import SiteLogo from '../components/SiteLogo.astro';
import Footer from '../components/Footer.astro';
import Partners from '../components/sections/Partners.astro';
import CustomCursor from '../components/CustomCursor.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { SITE } from '../config';
import { t, altLangPath, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: Lang;
}

const { ogImage = '/img/og-cover.png', lang = 'fr' } = Astro.props;
const T = t(lang);

const title = Astro.props.title ?? T.meta.home.title;
const description = Astro.props.description ?? T.meta.home.description;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageAbs = new URL(ogImage, SITE.url).href;

// hreflang : URL de l'alternative + x-default = FR (langue par défaut)
const altPath = altLangPath(Astro.url.pathname, lang === 'fr' ? 'en' : 'fr');
const frPath = lang === 'fr' ? Astro.url.pathname : altLangPath(Astro.url.pathname, 'fr');
const enPath = lang === 'en' ? Astro.url.pathname : altLangPath(Astro.url.pathname, 'en');
const frAbs = new URL(frPath, SITE.url).href;
const enAbs = new URL(enPath, SITE.url).href;

const htmlLang = lang === 'fr' ? 'fr-BE' : 'en';
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/img/hero.jpg', SITE.url).href,
  image: ogImageAbs,
  description,
  slogan: SITE.tagline,
  areaServed: { '@type': 'Country', name: 'Morocco' },
  knowsLanguage: ['fr', 'en'],
};
---
<!doctype html>
<html lang={htmlLang} data-lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="fr" href={frAbs} />
  <link rel="alternate" hreflang="en" href={enAbs} />
  <link rel="alternate" hreflang="x-default" href={frAbs} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=3" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=3" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=3" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbs} />

  <!-- JSON-LD : identité de l'organisation -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

  <!-- slot pour JSON-LD spécifique à la page -->
  <slot name="head" />

  <!-- Language auto-detect on first visit; respects cdm-lang cookie. -->
  <script is:inline define:vars={{ currentLang: lang, altPath }}>
    (function () {
      try {
        var sel = (document.cookie.match(/(?:^|; )cdm-lang=([^;]+)/) || [])[1];
        if (sel) {
          // Choix enregistré : on respecte, pas de redirection auto.
          if (sel !== currentLang && location.pathname.indexOf('/en') !== 0 && sel === 'en') {
            location.replace(altPath);
          } else if (sel !== currentLang && location.pathname.indexOf('/en') === 0 && sel === 'fr') {
            location.replace(altPath);
          }
          return;
        }
        var browser = (navigator.language || 'fr').slice(0, 2).toLowerCase();
        var browserLang = browser === 'en' ? 'en' : 'fr';
        if (browserLang !== currentLang) {
          location.replace(altPath);
        }
      } catch (e) { /* no-op */ }
    })();
  </script>

  {import.meta.env.PROD && SITE.gaId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
      <script is:inline define:vars={{ gaId: SITE.gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )}
</head>
<body>
  <CustomCursor />

  <button type="button" id="loader" aria-label={T.loader.enterAria}>
    <img
      id="llogo"
      class="loader-logo"
      src="/img/cdm-hybrid-white.svg"
      alt="CDM Motorsport"
      width="445"
      height="197"
    />
    <div class="bar" id="lbar"></div>
    <div class="l1" id="lw"></div>
  </button>

  <SiteLogo lang={lang} />
  <Header lang={lang} />

  <main>
    <slot />
  </main>

  <Partners lang={lang} />
  <Footer lang={lang} />

  <FloatingActions lang={lang} />

  <div id="lb"><img src="" alt="" /></div>
</body>
</html>

<style is:global>
  /* loader */
  #loader {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: #141008;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    width: 100%;
    border: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }
  #loader:focus-visible { outline: none; }
  #loader .l1 {
    font-family: var(--disp);
    font-weight: 300;
    color: #fff;
    font-size: clamp(22px, 4vw, 42px);
    letter-spacing: .5px;
    overflow: hidden;
    margin-top: 22px;
  }
  #loader .l1 span {
    display: inline-block;
    transform: translateY(110%);
    opacity: 0;
  }
  #loader .bar {
    width: 0;
    height: 1px;
    background: var(--sand);
    margin-top: 28px;
    transition: width 1.4s cubic-bezier(.7, 0, .2, 1);
  }
  #loader .loader-logo {
    width: clamp(180px, 22vw, 280px);
    height: auto;
    display: block;
    opacity: 0;
    transform: translateY(10px);
  }
  body.loaded #loader {
    transform: translateY(-100%);
    transition: transform 1s cubic-bezier(.76, 0, .24, 1);
  }

  /* lightbox */
  #lb {
    position: fixed;
    inset: 0;
    z-index: 9500;
    background: rgba(8, 6, 3, .95);
    display: none;
    align-items: center;
    justify-content: center;
  }
  #lb img { max-width: 92vw; max-height: 90vh; }
</style>

<script>
  // loader word reveal — slogan toujours anglais (identité de marque)
  (function () {
    const words = 'Every ride tells a story'.split(' ');
    const lw = document.getElementById('lw');
    const lbar = document.getElementById('lbar');
    if (lw) {
      lw.innerHTML = words.map((w) => '<span>' + w + '&nbsp;</span>').join('');
      const sp = lw.querySelectorAll('span');
      sp.forEach((s, i) => {
        s.animate(
          [
            { transform: 'translateY(110%)', opacity: 0 },
            { transform: 'translateY(0)', opacity: 1 },
          ],
          { duration: 600, delay: 200 + i * 140, fill: 'forwards', easing: 'cubic-bezier(.5,0,.2,1)' }
        );
      });
    }
    const llogo = document.getElementById('llogo');
    if (llogo) {
      llogo.animate(
        [
          { transform: 'translateY(10px)', opacity: 0 },
          { transform: 'translateY(0)', opacity: 1 },
        ],
        { duration: 700, delay: 80, fill: 'forwards', easing: 'cubic-bezier(.5,0,.2,1)' }
      );
    }

    if (lbar) setTimeout(() => (lbar.style.width = '180px'), 900);

    let done = false;
    function start(immediate = false) {
      if (done) return;
      done = true;
      const delay = immediate ? 0 : 2000;
      setTimeout(() => {
        document.body.classList.add('loaded');
        document.dispatchEvent(new CustomEvent('cdm:loaded'));
      }, delay);
    }
    window.addEventListener('load', () => start());
    setTimeout(() => start(), 3000);

    const loader = document.getElementById('loader');
    loader?.addEventListener('click', () => start(true));
  })();

  // reveal observer
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    }),
    { threshold: .15 }
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // parallax
  const px = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  addEventListener('scroll', () => {
    px.forEach((el) => {
      const parent = el.parentElement;
      if (!parent) return;
      const r = parent.getBoundingClientRect();
      const off = (r.top + r.height / 2 - innerHeight / 2) * -.12;
      el.style.transform = 'translateY(' + off + 'px) scale(1.12)';
    });
  }, { passive: true });

  // lightbox
  const lb = document.getElementById('lb');
  const lbi = lb?.querySelector('img');
  document.querySelectorAll<HTMLAnchorElement>('.ggrid a, .hotels-grid a').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const img = a.querySelector('img');
      if (lb && lbi && img) {
        lbi.src = a.getAttribute('href') || img.src;
        lb.style.display = 'flex';
      }
    });
  });
  lb?.addEventListener('click', () => (lb.style.display = 'none'));
</script>
