---
import { t, pathTo, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);

const links = T.footer.links.map((l) => ({ label: l.label, href: pathTo(l.path, lang) }));
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <a href={pathTo('/', lang)} class="flogo" aria-label={T.footer.logoAria}>
      <img src="/img/cdm-hybrid-white.svg" alt="CDM Motorsport" width="445" height="197" />
    </a>
    <nav class="fmenu">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
  <div class="fbtm">{T.footer.copyright(year)}</div>
</footer>

<style is:global>
  footer {
    background: #141008;
    color: #8c8073;
    padding: 60px 0 30px;
    position: relative;
    z-index: 2;
  }
  footer::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: .06;
    background-image: url('/img/g6.jpg');
    background-size: cover;
    background-position: center;
  }
  footer .wrap {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }
  .flogo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .flogo img {
    height: 60px;
    width: auto;
    display: block;
  }
  @media (max-width: 640px) {
    .flogo img { height: 48px; }
  }
  .fmenu {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }
  .fmenu a {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #cbbfae;
  }
  .fbtm {
    position: relative;
    text-align: center;
    font-size: 11px;
    color: #6f6455;
    margin-top: 30px;
    letter-spacing: .5px;
  }
</style>
