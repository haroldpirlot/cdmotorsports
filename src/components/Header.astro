---
// Header + sélecteur de langue (desktop & mobile).
// Lit ses libellés dans l'i18n dict et calcule l'URL de l'autre langue.
import { t, altLangPath, pathTo, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);

const otherLang: Lang = lang === 'fr' ? 'en' : 'fr';
const otherLangHref = altLangPath(Astro.url.pathname, otherLang);

const primary = [
  { label: T.nav.raids,    href: pathTo('/#raids', lang) },
  { label: T.nav.moto,     href: pathTo('/moto-kove-450-rally', lang) },
  { label: T.nav.morocco,  href: pathTo('/#maroc', lang) },
];
const discover = [
  { label: T.nav.practical, href: pathTo('/#infos', lang) },
  { label: T.nav.option4x4, href: pathTo('/option-4x4', lang) },
  { label: T.nav.about,     href: pathTo('/edouard-de-moor', lang) },
  { label: T.nav.blog,      href: pathTo('/actualites', lang) },
  { label: T.nav.shop,      href: pathTo('/boutique', lang) },
];
---
<header id="hd">
  <div class="wrap nav">
    <div class="nav-right" id="nav-right">
    <nav class="menu" id="menu" aria-label={T.nav.ariaMain}>
      {primary.map((item) => (
        <a href={item.href} class="menu-link">{item.label}</a>
      ))}

      <div class="menu-dropdown" id="dropdown">
        <button
          type="button"
          class="menu-link menu-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="dropdown-panel"
        >
          {T.nav.discover}
          <svg class="chev" viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M1 1.5 L6 6.5 L11 1.5"/>
          </svg>
        </button>
        <div id="dropdown-panel" class="menu-panel" role="menu">
          {discover.map((item) => (
            <a href={item.href} class="menu-panel-link" role="menuitem">{item.label}</a>
          ))}
        </div>
      </div>

      <a
        href={otherLangHref}
        class="menu-lang"
        data-lang-switch={otherLang}
        aria-label={T.nav.switchLangAria}
        title={T.nav.switchLang}
      >
        <span class="menu-lang-current" aria-hidden="true">{T.nav.currentLangLabel}</span>
        <span class="menu-lang-sep" aria-hidden="true">/</span>
        <span class="menu-lang-other" aria-hidden="true">{T.nav.otherLangLabel}</span>
      </a>

      <a href={pathTo('/reserver', lang)} class="menu-cta">{T.nav.book}</a>
    </nav>

    <button type="button" class="burger" id="burger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span>
    </button>
    </div>
  </div>
</header>

<style is:global>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    padding: 22px 0;
    pointer-events: none;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 28px;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 28px;
    transition: transform .4s ease, opacity .3s ease;
    pointer-events: auto;
  }
  header.hide .nav-right {
    transform: translateY(-140%);
    opacity: 0;
    pointer-events: none;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .menu-link {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.4px;
    color: #fff;
    text-transform: uppercase;
    position: relative;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    mix-blend-mode: difference;
  }
  .menu-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .3s ease;
  }
  .menu-link:hover::after,
  .menu-link:focus-visible::after { transform: scaleX(1); }
  .menu-trigger .chev { transition: transform .25s ease; }
  .menu-dropdown[data-open="true"] .menu-trigger .chev { transform: rotate(180deg); }

  .menu-dropdown { position: relative; }
  .menu-panel {
    position: absolute;
    top: calc(100% + 14px);
    left: -18px;
    min-width: 220px;
    background: #fff;
    border-radius: 3px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, .18);
    padding: 10px 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .18s ease, transform .18s ease, visibility 0s linear .18s;
    display: flex;
    flex-direction: column;
  }
  .menu-dropdown:hover .menu-panel,
  .menu-dropdown:focus-within .menu-panel,
  .menu-dropdown[data-open="true"] .menu-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }
  .menu-panel-link {
    padding: 11px 22px;
    font-family: var(--sans);
    font-weight: 500;
    font-size: 14px;
    color: #1a1613;
    text-transform: none;
    letter-spacing: .1px;
    transition: background .18s ease, color .18s ease;
  }
  .menu-panel-link:hover { background: var(--cream); color: #B4642C; }

  .menu-lang {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #fff;
    mix-blend-mode: difference;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    border: 1px solid rgba(255, 255, 255, .55);
    border-radius: 2px;
    line-height: 1;
    transition: border-color .2s ease, background .2s ease;
  }
  .menu-lang:hover,
  .menu-lang:focus-visible { border-color: #fff; }
  .menu-lang-current { font-weight: 800; }
  .menu-lang-sep { opacity: .55; }
  .menu-lang-other { opacity: .78; }

  .menu-cta {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.4px;
    color: #fff;
    text-transform: uppercase;
    background: #B4642C;
    padding: 12px 22px;
    border-radius: 2px;
    line-height: 1;
    transition: background .2s ease, transform .2s ease;
  }
  .menu-cta:hover { background: #93511f; transform: translateY(-1px); }

  .burger {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    padding: 6px;
    cursor: pointer;
    mix-blend-mode: difference;
  }
  .burger span {
    width: 26px;
    height: 1.5px;
    background: #fff;
    transition: transform .25s ease, opacity .25s ease;
  }
  .burger[aria-expanded="true"] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .burger[aria-expanded="true"] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  @media (max-width: 960px) {
    .menu { display: none; }
    .burger { display: flex; }

    .menu.open {
      display: flex;
      position: fixed;
      inset: 0;
      background: #141008;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      padding: 100px 34px 40px;
      gap: 6px;
      overflow-y: auto;
    }
    .menu.open .menu-link {
      font-size: 20px;
      letter-spacing: 1px;
      color: #fff;
      mix-blend-mode: normal;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, .1);
    }
    .menu.open .menu-link::after { display: none; }
    .menu.open .menu-dropdown { position: static; }
    .menu.open .menu-panel {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: transparent;
      box-shadow: none;
      padding: 0;
      display: none;
      transition: none;
    }
    .menu.open .menu-dropdown[data-open="true"] .menu-panel { display: flex; }
    .menu.open .menu-panel-link {
      color: #cbbfae;
      font-size: 16px;
      padding: 10px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, .06);
    }
    .menu.open .menu-panel-link:hover { background: transparent; color: #B4642C; }
    .menu.open .menu-lang {
      align-self: flex-start;
      margin-top: 18px;
      font-size: 13px;
      padding: 10px 14px;
      color: #fff;
      mix-blend-mode: normal;
      border-color: rgba(255, 255, 255, .4);
    }
    .menu.open .menu-cta {
      align-self: flex-start;
      margin-top: 14px;
      font-size: 14px;
      padding: 14px 26px;
    }
  }
</style>

<script>
  const hd = document.getElementById('hd');
  const menu = document.getElementById('menu');
  const burger = document.getElementById('burger');
  const dropdown = document.getElementById('dropdown');
  const trigger = dropdown?.querySelector<HTMLButtonElement>('.menu-trigger');

  if (hd) {
    let last = 0;
    addEventListener('scroll', () => {
      const y = scrollY;
      hd.classList.toggle('hide', y > last && y > 400);
      last = y;
    }, { passive: true });
  }

  if (burger && menu) {
    burger.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open && hd) hd.classList.remove('hide');
    });
    menu.querySelectorAll<HTMLElement>('a').forEach((a) => {
      a.addEventListener('click', () => {
        if (menu.classList.contains('open')) {
          menu.classList.remove('open');
          burger.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          if (dropdown) dropdown.setAttribute('data-open', 'false');
        }
      });
    });
  }

  if (dropdown && trigger) {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = dropdown.getAttribute('data-open') === 'true';
      dropdown.setAttribute('data-open', String(!isOpen));
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node)) {
        dropdown.setAttribute('data-open', 'false');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdown.setAttribute('data-open', 'false');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.blur();
      }
    });
  }

  // Mémorise le choix manuel de langue (cookie 1 an) pour bloquer l'auto-redirect.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      const choice = a.getAttribute('data-lang-switch');
      if (!choice) return;
      const maxAge = 60 * 60 * 24 * 365;
      document.cookie = `cdm-lang=${choice}; path=/; max-age=${maxAge}; samesite=lax`;
    });
  });
</script>
