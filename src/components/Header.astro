---
// Navigation restructurée :
//  - Raids
//  - Découvrir (dropdown : Moto / Maroc / Qui suis-je / Infos pratiques)
//  - Blog
//  - Boutique
//  - Réserver (bouton mis en avant, plein terracotta)
//
// Comportement :
//  - Desktop : dropdown au survol + focus clavier.
//  - Mobile : hamburger déroule tout, sous-items "Découvrir" listés en dessous.
//  - Logo et libellés menu conservent l'inversion via mix-blend-mode: difference
//    appliqué individuellement (pas sur le header) pour ne pas altérer le CTA.

const primary = [
  { label: 'Raids',    href: '/#raids' },
];
const discover = [
  { label: 'La Moto',         href: '/moto-kove-450-rally' },
  { label: 'Le Maroc',        href: '/#maroc' },
  { label: 'Qui suis-je',     href: '/edouard-de-moor' },
  { label: 'Infos pratiques', href: '/#infos' },
];
const secondary = [
  { label: 'Blog',     href: '/actualites' },
  { label: 'Boutique', href: '/boutique' },
];
---
<header id="hd">
  <div class="wrap nav">
    <a href="/" class="logo" aria-label="Accueil CDM Motorsport">
      <svg
        class="logo-svg"
        viewBox="733.8 447.9 445.2 197.3"
        role="img"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
