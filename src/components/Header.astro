          <path id="logo-s" d="M.28799439-.0107421879C.44699098-.0107421879 .5119934 .058258058 .5119934 .16026306 .5119934 .24327088 .46798707 .30229188 .29899598 .33428956 .1619873 .3612976 .12998963 .39830018 .12998963 .4533081 .12998963 .5133209 .1749878 .5503235 .2689972 .5503235 .36898805 .5503235 .40499879 .50531008 .4249878 .41830445L.49699403 .43330384C.47299195 .5413208 .4139862 .6113281 .27198792 .6113281 .12998963 .6113281 .05899048 .5473175 .05899048 .4493103 .05899048 .36228944 .11199951 .3012848 .2749939 .27227784 .397995 .25027467 .43998719 .2192688 .43998719 .15525818 .43998719 .09225464 .394989 .050247194 .2899933 .050247194 .1749878 .050247194 .116989139 .10525513 .099990848 .20626831L.0309906 .19126892C.04798889 .070251468 .12399292-.009750366 .28799439-.0107421879Z"/>
          <path id="logo-p" d="M.29299928 .53660586C.39698792 .53660586 .43299867 .4986725 .43299867 .41281129 .43299867 .32896424 .3909912 .29003907 .2939911 .29003907H.14498902V.53660586H.29299928M.3019867 .22903443C.43299867 .22903443 .5039978 .30400086 .5039978 .41381837 .5039978 .53860476 .43499757 .5996094 .2999878 .5996094H.07299805V0H.14498902V.22903443H.3019867Z"/>
        </defs>
        <use href="#logo-c" transform="matrix(31.7922,0,0,-32.4718,762.2544,630.3601)" fill="currentColor"/>
        <use href="#logo-d" transform="matrix(31.7922,0,0,-32.4718,796.36746,630.3601)" fill="currentColor"/>
        <use href="#logo-m" transform="matrix(31.7922,0,0,-32.4718,830.7348,630.3601)" fill="currentColor"/>
        <use href="#logo-o" transform="matrix(31.7922,0,0,-32.4718,870.09359,630.3601)" fill="currentColor"/>
        <use href="#logo-t" transform="matrix(31.7922,0,0,-32.4718,904.58816,630.3601)" fill="currentColor"/>
        <use href="#logo-o" transform="matrix(31.7922,0,0,-32.4718,934.12307,630.3601)" fill="currentColor"/>
        <use href="#logo-r" transform="matrix(31.7922,0,0,-32.4718,969.3488,630.3601)" fill="currentColor"/>
        <use href="#logo-s" transform="matrix(31.7922,0,0,-32.4718,1001.8404,630.3601)" fill="currentColor"/>
        <use href="#logo-p" transform="matrix(31.7922,0,0,-32.4718,1033.6326,630.3601)" fill="currentColor"/>
        <use href="#logo-o" transform="matrix(31.7922,0,0,-32.4718,1064.5664,630.3601)" fill="currentColor"/>
        <use href="#logo-r" transform="matrix(31.7922,0,0,-32.4718,1099.7921,630.3601)" fill="currentColor"/>
        <use href="#logo-t" transform="matrix(31.7922,0,0,-32.4718,1132.6653,630.3601)" fill="currentColor"/>
        <path transform="matrix(1,0,0,-1,1017.9471,502.68818)" d="M0 0-7.417-25.688C-14.176-49.097-35.296-66.801-60.648-66.969L-145.119-67.53-145.044 19.647-110.672 19.95-110.623-39.214-63.157-38.549C-54.276-38.424-41.577-30.554-39.059-22.143L-23.517 29.766C-20.844 38.691-15.021 44.916-6.011 45.892 2.076 46.768 10.13 42.713 14.623 34.721L50.936-29.862 88.471 36.608C91.939 42.747 101.251 46.538 106.912 45.937 114.949 45.084 121.361 40.09 124.581 32.318L153.063-67.212 119.136-67.801 100.542 .989 70.047-57.303C65.686-65.639 58.055-69.964 49.349-69.742 40.826-69.524 33.879-64.276 29.985-55.864Z" fill="currentColor"/>
        <path transform="matrix(1,0,0,-1,783.4923,513.4618)" d="M0 0C.583 11.763 10.913 25.331 25.575 25.389L78.322 25.644V54.68L27.669 54.597C13.291 54.578-1.461 49.504-12.668 41.569-38.314 23.407-41.679-10.915-21.112-34.829-9.021-48.888 10.393-56.37 29.396-56.57L75.198-57.052 74.969-28.41C41.331-28.303-1.663-33.57 0 0" fill="currentColor"/>
        <path transform="matrix(1,0,0,-1,949.3416,458.67988)" d="M0 0-76.644-.104V-29.144L.033-28.834C8.34-28.801 15.955-32.813 23.635-36.816L32.642-6.115C21.454-2.793 11.249 .015 0 0" fill="currentColor"/>
      </svg>
    </a>

    <nav class="menu" id="menu" aria-label="Navigation principale">
      {primary.map((item) => (
        <a href={item.href} class="menu-link">{item.label}</a>
      ))}

      <div class="menu-dropdown" id="dropdown">
        <button
          type="button"
          class="menu-link menu-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="dropdown-panel"
        >
          Découvrir
          <svg class="chev" viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M1 1.5 L6 6.5 L11 1.5"/>
          </svg>
        </button>
        <div id="dropdown-panel" class="menu-panel" role="menu">
          {discover.map((item) => (
            <a href={item.href} class="menu-panel-link" role="menuitem">{item.label}</a>
          ))}
        </div>
      </div>

      {secondary.map((item) => (
        <a href={item.href} class="menu-link">{item.label}</a>
      ))}

      <a href="/reserver" class="menu-cta">Réserver</a>
    </nav>

    <button type="button" class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
</header>

<style is:global>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    padding: 22px 0;
    transition: transform .4s, background .3s;
    /* pas de mix-blend-mode sur le header : le CTA plein ne doit pas s'inverser */
  }
  header.hide { transform: translateY(-100%); }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  /* Logo : inversion via mix-blend-mode (blanc sur hero sombre, sombre ailleurs) */
  .logo {
    color: #fff;
    display: inline-flex;
    align-items: center;
    line-height: 0;
    mix-blend-mode: difference;
  }
  .logo-svg {
    height: 40px;
    width: auto;
    display: block;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .menu-link {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.4px;
    color: #fff;
    text-transform: uppercase;
    position: relative;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    mix-blend-mode: difference;
  }
  .menu-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .3s ease;
  }
  .menu-link:hover::after,
  .menu-link:focus-visible::after { transform: scaleX(1); }
  .menu-trigger .chev { transition: transform .25s ease; }
  .menu-dropdown[data-open="true"] .menu-trigger .chev { transform: rotate(180deg); }

  .menu-dropdown { position: relative; }
  .menu-panel {
    position: absolute;
    top: calc(100% + 14px);
    left: -18px;
    min-width: 220px;
    background: #fff;
    border-radius: 3px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, .18);
    padding: 10px 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .18s ease, transform .18s ease, visibility 0s linear .18s;
    display: flex;
    flex-direction: column;
  }
  .menu-dropdown:hover .menu-panel,
  .menu-dropdown:focus-within .menu-panel,
  .menu-dropdown[data-open="true"] .menu-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }
  .menu-panel-link {
    padding: 11px 22px;
    font-family: var(--sans);
    font-weight: 500;
    font-size: 14px;
    color: #1a1613;
    text-transform: none;
    letter-spacing: .1px;
    transition: background .18s ease, color .18s ease;
  }
  .menu-panel-link:hover { background: var(--cream); color: #B4642C; }

  .menu-cta {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.4px;
    color: #fff;
    text-transform: uppercase;
    background: #B4642C;
    padding: 12px 22px;
    border-radius: 2px;
    line-height: 1;
    transition: background .2s ease, transform .2s ease;
  }
  .menu-cta:hover { background: #93511f; transform: translateY(-1px); }

  .burger {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    padding: 6px;
    cursor: pointer;
    mix-blend-mode: difference;
  }
  .burger span {
    width: 26px;
    height: 1.5px;
    background: #fff;
    transition: transform .25s ease, opacity .25s ease;
  }
  .burger[aria-expanded="true"] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .burger[aria-expanded="true"] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  @media (max-width: 960px) {
    .menu { display: none; }
    .burger { display: flex; }

    .menu.open {
      display: flex;
      position: fixed;
      inset: 0;
      background: #141008;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      padding: 100px 34px 40px;
      gap: 6px;
      overflow-y: auto;
    }
    .menu.open .menu-link {
      font-size: 20px;
      letter-spacing: 1px;
      color: #fff;
      mix-blend-mode: normal;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, .1);
    }
    .menu.open .menu-link::after { display: none; }
    .menu.open .menu-dropdown { position: static; }
    .menu.open .menu-panel {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: transparent;
      box-shadow: none;
      padding: 0;
      display: none;
      transition: none;
    }
    .menu.open .menu-dropdown[data-open="true"] .menu-panel { display: flex; }
    .menu.open .menu-panel-link {
      color: #cbbfae;
      font-size: 16px;
      padding: 10px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, .06);
    }
    .menu.open .menu-panel-link:hover { background: transparent; color: #B4642C; }
    .menu.open .menu-cta {
      align-self: flex-start;
      margin-top: 18px;
      font-size: 14px;
      padding: 14px 26px;
    }
  }
</style>

<script>
  const hd = document.getElementById('hd');
  const menu = document.getElementById('menu');
  const burger = document.getElementById('burger');
  const dropdown = document.getElementById('dropdown');
  const trigger = dropdown?.querySelector<HTMLButtonElement>('.menu-trigger');

  if (hd) {
    let last = 0;
    addEventListener('scroll', () => {
      const y = scrollY;
      hd.classList.toggle('hide', y > last && y > 400);
      last = y;
    }, { passive: true });
  }

  if (burger && menu) {
    burger.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    });
    // Ferme le menu mobile au clic sur un lien (mais pas sur le trigger dropdown)
    menu.querySelectorAll<HTMLElement>('a').forEach((a) => {
      a.addEventListener('click', () => {
        if (menu.classList.contains('open')) {
          menu.classList.remove('open');
          burger.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          if (dropdown) dropdown.setAttribute('data-open', 'false');
        }
      });
    });
  }

  if (dropdown && trigger) {
    // Tap/clic : toggle explicite (utile mobile + a11y clavier).
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = dropdown.getAttribute('data-open') === 'true';
      dropdown.setAttribute('data-open', String(!isOpen));
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
    // Ferme au clic extérieur.
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node)) {
        dropdown.setAttribute('data-open', 'false');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
    // Escape ferme.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdown.setAttribute('data-open', 'false');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.blur();
      }
    });
  }
</script>
