---
// Logo global positionné à fond bas (z-index: 1), au-dessus du body mais
// SOUS les sections opaques. Résultat : masqué par les sections à photo /
// bg opaque, visible via les sections transparentes (= bg beige du body).
// Le hero vidéo est explicitement en z-index: 0 pour laisser le logo dessus.
// mix-blend-mode: difference sur la variante blanche → apparaît blanc sur
// vidéo/photos sombres, et marine sur le beige du body.
---
<div class="site-logo-outer">
  <div class="wrap">
    <a href="/" class="site-logo" aria-label="Retour à l'accueil">
      <img
        class="site-logo-svg"
        src="/img/cdm-hybrid-white.svg"
        alt="CDM Motorsport"
        width="445"
        height="197"
      />
    </a>
  </div>
</div>

<style is:global>
  .site-logo-outer {
    position: fixed;
    top: 18px;
    left: 0;
    right: 0;
    z-index: 1;              /* sous les sections opaques, au-dessus du body */
    pointer-events: none;    /* les clics passent aux éléments dessous */
  }
  .site-logo-outer .wrap {
    /* .wrap : max-width 1280px, padding 0 34px, centré, hérité de global.css */
    line-height: 0;
  }
  .site-logo {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    /* difference : marine sur fond beige, blanc sur photo sombre. Photos
       opaques (au-dessus dans la stack) le masquent totalement. */
    mix-blend-mode: difference;
  }
  .site-logo-svg {
    height: 76px;
    width: auto;
    display: block;
  }
  @media (max-width: 960px) {
    .site-logo-outer { top: 14px; }
    .site-logo-svg { height: 54px; }
  }
</style>
