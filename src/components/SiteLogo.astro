---
import { t, pathTo, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);
---
<div class="site-logo-outer">
  <div class="wrap">
    <a href={pathTo('/', lang)} class="site-logo" aria-label={T.siteLogo.aria}>
      <img
        class="site-logo-svg"
        src="/img/cdm-hybrid-white.svg"
        alt="CDM Motorsport"
        width="445"
        height="197"
      />
    </a>
  </div>
</div>

<style is:global>
  .site-logo-outer {
    position: fixed;
    top: 18px;
    left: 0;
    right: 0;
    z-index: 1;
    pointer-events: none;
  }
  .site-logo-outer .wrap {
    line-height: 0;
  }
  .site-logo {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    mix-blend-mode: difference;
  }
  .site-logo-svg {
    height: 76px;
    width: auto;
    display: block;
  }
  @media (max-width: 960px) {
    .site-logo-outer { top: 14px; }
    .site-logo-svg { height: 54px; }
  }
</style>
