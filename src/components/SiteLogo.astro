      </svg>
    </a>
  </div>
</div>

<style is:global>
  .site-logo-outer {
    position: fixed;
    top: 18px;
    left: 0;
    right: 0;
    z-index: 1;              /* sous les sections opaques, au-dessus du body */
    pointer-events: none;    /* les clics passent aux éléments dessous */
  }
  .site-logo-outer .wrap {
    /* .wrap : max-width 1280px, padding 0 34px, centré, hérité de global.css */
    line-height: 0;
  }
  .site-logo {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    color: #fff;
    /* difference : sombre sur fond beige, clair sur photo sombre. Photos
       opaques (au-dessus dans la stack) le masquent totalement. */
    mix-blend-mode: difference;
  }
  .site-logo-svg {
    height: 64px;
    width: auto;
    display: block;
  }
  @media (max-width: 960px) {
    .site-logo-outer { top: 14px; }
    .site-logo-svg { height: 46px; }
  }
</style>
