---
import { SITE } from '../config';
---
<a
  id="wa-float"
  class="wa-float"
  href={SITE.whatsappUrl}
  target="_blank"
  rel="noopener"
  aria-label="Écrire sur WhatsApp"
  title="WhatsApp"
>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
    <path fill="currentColor" d="M16.02 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.26.6 4.46 1.72 6.4L3.2 28.8l6.56-1.72a12.72 12.72 0 0 0 6.26 1.62h.02c7.06 0 12.8-5.74 12.8-12.8 0-3.42-1.34-6.62-3.76-9.04A12.7 12.7 0 0 0 16.02 3.2Zm0 23.4h-.02a10.6 10.6 0 0 1-5.4-1.48l-.38-.22-3.9 1.02 1.04-3.8-.24-.4a10.6 10.6 0 0 1-1.62-5.62c0-5.86 4.76-10.62 10.62-10.62 2.84 0 5.5 1.1 7.5 3.12a10.6 10.6 0 0 1 3.12 7.5c0 5.86-4.76 10.62-10.62 10.62Zm5.82-7.94c-.32-.16-1.88-.92-2.18-1.02-.3-.1-.5-.16-.72.16-.22.32-.82 1.02-1 1.24-.18.22-.36.24-.68.08-.32-.16-1.34-.5-2.56-1.58a9.62 9.62 0 0 1-1.78-2.2c-.18-.32-.02-.5.14-.66.14-.14.32-.36.48-.54.16-.18.22-.32.34-.54.1-.22.06-.4-.02-.56-.08-.16-.72-1.72-.98-2.36-.26-.62-.52-.54-.72-.54H10.8c-.2 0-.54.08-.82.4-.28.32-1.08 1.06-1.08 2.58 0 1.52 1.1 2.98 1.26 3.2.16.22 2.18 3.32 5.28 4.66.74.32 1.32.5 1.76.66.74.24 1.42.2 1.96.12.6-.08 1.88-.76 2.14-1.5.26-.74.26-1.36.18-1.5-.08-.14-.28-.22-.6-.38Z"/>
  </svg>
</a>

<button id="back-top" class="back-top" aria-label="Remonter en haut de la page" title="Remonter">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 19V5M5 12l7-7 7 7"/>
  </svg>
</button>

<style>
  .wa-float {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 8500;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25D366;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 20px rgba(0, 0, 0, .25);
    transition: transform .2s ease, box-shadow .2s ease;
    text-decoration: none;
  }
  .wa-float:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, .3);
  }
  .back-top {
    position: fixed;
    right: 22px;
    bottom: 90px;
    z-index: 8400;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(20, 16, 8, .78);
    color: #f5eddb;
    border: 1px solid rgba(255, 255, 255, .12);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity .25s ease, transform .25s ease, background .2s ease;
  }
  .back-top.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .back-top:hover {
    background: rgba(20, 16, 8, .95);
  }
  @media (max-width: 640px) {
    .wa-float { width: 52px; height: 52px; right: 16px; bottom: 16px; }
    .back-top { right: 16px; bottom: 78px; width: 36px; height: 36px; }
  }
</style>

<script>
  const backTop = document.getElementById('back-top');
  if (backTop) {
    const toggle = () => {
      if (window.scrollY > 480) backTop.classList.add('visible');
      else backTop.classList.remove('visible');
    };
    toggle();
    window.addEventListener('scroll', toggle, { passive: true });
    backTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
