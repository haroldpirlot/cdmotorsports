---
const raids = [
  { idx: '01', title: 'Odyssée du Sud',        days: 7, level: 'Confirmé',      km: '1 480 km', img: '/img/raid_dune.jpg', slug: 'odyssee-du-sud' },
  { idx: '02', title: "Boucle de l'Anti-Atlas", days: 5, level: 'Intermédiaire', km: '924 km',   img: '/img/raid_mont.jpg', slug: 'boucle-anti-atlas' },
  { idx: '03', title: 'Cap Merzouga',           days: 6, level: 'Confirmé',      km: '1 232 km', img: '/img/pin.jpg',       slug: 'cap-merzouga' },
  { idx: '04', title: 'Océan & Atlas',          days: 6, level: 'Confirmé',      km: '1 290 km', img: '/img/raid_cote.jpg', slug: 'ocean-atlas' },
  { idx: '05', title: 'Escapade Drâa',          days: 3, level: 'Confirmé',      km: '800 km',   img: '/img/band.jpg',      slug: 'escapade-draa' },
  { idx: '06', title: 'Échappée Atlantique',    days: 3, level: 'Intermédiaire', km: '665 km',   img: '/img/g9.jpg',        slug: 'echappee-atlantique' },
  { idx: '07', title: 'Immersion Erg',          days: 3, level: 'Découverte',    km: '460 km',   img: '/img/g8.jpg',        slug: 'immersion-erg' },
];
---
<section class="raids pad" id="raids">
  <div class="wrap head">
    <div class="reveal">
      <div class="eyebrow" style="margin-bottom:16px">Les raids</div>
      <div class="big">Choisissez votre <em>terrain</em></div>
    </div>
    <div class="drag-note reveal">↔ Glissez pour explorer</div>
  </div>
  <div class="rtrack" id="rtrack">
    {raids.map((r) => (
      <div class="rcard">
        <div class="ph">
          <span class="idx">{r.idx}</span>
          <img src={r.img} alt={r.title} />
          <div class="cap">
            <h3>{r.title}</h3>
            <div class="meta">
              <span><b>{r.days}</b> jours</span>
              <span>{r.level}</span>
              <span>{r.km}</span>
            </div>
          </div>
        </div>
        <div class="price">Prix &amp; dates <b>sur demande</b></div>
        <a class="rlink" href={`/raids/${r.slug}`}>Voir le raid →</a>
      </div>
    ))}
  </div>
</section>

<script>
  const rt = document.getElementById('rtrack');
  if (rt) {
    let down = false, sx = 0, sl = 0, moved = false;
    rt.addEventListener('pointerdown', (e) => {
      down = true; moved = false;
      rt.classList.add('drag');
      sx = e.pageX; sl = rt.scrollLeft;
    });
    addEventListener('pointerup', () => {
      down = false;
      rt.classList.remove('drag');
    });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      if (Math.abs(e.pageX - sx) > 6) moved = true;
      rt.scrollLeft = sl - (e.pageX - sx) * 1.4;
    });
    rt.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        rt.scrollLeft += e.deltaY;
        e.preventDefault();
      }
    }, { passive: false });
    document.querySelectorAll<HTMLElement>('.rcard').forEach((c) => {
      c.addEventListener('click', (e) => {
        if (moved) { e.preventDefault(); return; }
        const a = c.querySelector<HTMLAnchorElement>('.rlink');
        if (a) location.href = a.getAttribute('href')!;
      });
    });
  }
</script>
