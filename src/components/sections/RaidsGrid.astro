---
import { getCollection } from 'astro:content';
import { t, pathTo, type Lang } from '../../i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);

const collection = lang === 'en' ? 'raidsEn' : 'raids';
const raids = (await getCollection(collection)).sort((a, b) => a.data.n - b.data.n);
const fmtLocale = lang === 'en' ? 'en-US' : 'fr-FR';
const fmtKm = (n: number) => n.toLocaleString(fmtLocale);
const fmtPrice = (n: number) => n.toLocaleString(fmtLocale) + ' €';
---
<section class="raids pad" id="raids">
  <div class="wrap head">
    <div class="reveal">
      <div class="eyebrow" style="margin-bottom:16px">{T.raidsGrid.eyebrow}</div>
      <div class="big">{T.raidsGrid.titleStart}<em>{T.raidsGrid.titleEm}</em></div>
    </div>
    <div class="drag-note reveal">{T.raidsGrid.dragNote}</div>
  </div>
  <div class="rtrack" id="rtrack">
    {raids.map((raid) => {
      const totalKm = raid.data.stages.reduce((s, x) => s + x.km, 0);
      const isComing = raid.data.status === 'coming-soon';
      return (
        <div class={`rcard${isComing ? ' coming' : ''}`}>
          <div class="ph">
            <span class="idx">{String(raid.data.n).padStart(2, '0')}</span>
            {isComing && <span class="badge-coming">{T.raidsGrid.badgeComing}</span>}
            <img src={raid.data.hero} alt={raid.data.name} />
            <div class="cap">
              <h3>{raid.data.name}</h3>
              <div class="meta">
                <span><b>{raid.data.days}</b> {T.raidsGrid.daysLabel}</span>
                <span>{fmtKm(totalKm)} km</span>
                <span>{raid.data.itin}</span>
              </div>
            </div>
          </div>
          <div class="price">
            {raid.data.pricePerPerson
              ? (<><b>{fmtPrice(raid.data.pricePerPerson)}</b><span class="pp">{T.raidsGrid.pricePerPerson}</span></>)
              : (<>{T.raidsGrid.priceTbd[0]}<b>{T.raidsGrid.priceTbd[1]}</b></>)}
          </div>
          <a class="rlink" href={pathTo(`/raids/${raid.id}`, lang)}>
            {isComing ? T.raidsGrid.linkComing : T.raidsGrid.linkLive}
          </a>
        </div>
      );
    })}
  </div>
</section>

<script>
  const rt = document.getElementById('rtrack');
  if (rt) {
    let down = false, sx = 0, sl = 0, moved = false;
    rt.addEventListener('pointerdown', (e) => {
      down = true; moved = false;
      rt.classList.add('drag');
      sx = e.pageX; sl = rt.scrollLeft;
    });
    addEventListener('pointerup', () => {
      down = false;
      rt.classList.remove('drag');
    });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      if (Math.abs(e.pageX - sx) > 6) moved = true;
      rt.scrollLeft = sl - (e.pageX - sx) * 1.4;
    });
    rt.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        rt.scrollLeft += e.deltaY;
        e.preventDefault();
      }
    }, { passive: false });
    document.querySelectorAll<HTMLElement>('.rcard').forEach((c) => {
      c.addEventListener('click', (e) => {
        if (moved) { e.preventDefault(); return; }
        const a = c.querySelector<HTMLAnchorElement>('.rlink');
        if (a) location.href = a.getAttribute('href')!;
      });
    });
  }
</script>
