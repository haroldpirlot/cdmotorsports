---
import { getCulture } from '../../data/culture';
import { t, pathTo, type Lang } from '../../i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);
const items = getCulture(lang);
---
<section class="maroc pad" id="maroc">
  <div class="wrap">
    <div class="reveal">
      <div class="eyebrow" style="margin-bottom:16px">{T.morocco.eyebrow}</div>
      <div class="big">
        {T.morocco.big1}<br />
        {T.morocco.big2a}<em>{T.morocco.big2em}</em>
      </div>
      <p class="lede">{T.morocco.lede}</p>
      <div class="mfacts">
        <div>
          <h4>{T.morocco.factCountryTitle}</h4>
          <p>{T.morocco.factCountry}</p>
        </div>
        <div>
          <h4>{T.morocco.factClimateTitle}</h4>
          <p>{T.morocco.factClimate}</p>
        </div>
      </div>

      <div class="mrencontres">
        <h3>{T.morocco.meetTitle}</h3>
        <p>{T.morocco.meetBody}</p>
      </div>
    </div>
    <div class="mstrip reveal">
      {items.map((s) => (
        <a class="mtile" href={pathTo(`/le-maroc/${s.slug}`, lang)} aria-label={T.morocco.tileLabel(s.title)}>
          {s.imageBase ? (
            <picture>
              <source
                type="image/webp"
                srcset={`${s.imageBase}-800.webp 800w, ${s.imageBase}-1400.webp 1400w`}
                sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"
              />
              <img src={s.image} alt={s.imageAlt} loading="lazy" decoding="async" />
            </picture>
          ) : (
            <img src={s.image} alt={s.imageAlt} loading="lazy" decoding="async" />
          )}
          <span class="mcap">{s.caption}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .mrencontres {
    margin-top: 40px;
    padding-top: 34px;
    border-top: 1px solid var(--line);
    max-width: 780px;
  }
  .mrencontres h3 {
    font-family: var(--disp);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(20px, 2.4vw, 26px);
    color: var(--ink);
    letter-spacing: -.2px;
    margin-bottom: 14px;
  }
  .mrencontres p {
    color: #4c4438;
    font-size: 16px;
    line-height: 1.65;
  }

  .mtile {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .mtile::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, .55) 100%);
    pointer-events: none;
    transition: opacity .3s ease;
  }
  .mtile:hover::after { opacity: .85; }
  .mtile .mcap {
    position: absolute;
    left: 16px;
    bottom: 14px;
    color: #fff;
    font-family: var(--disp);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 13px;
    z-index: 2;
  }
</style>
