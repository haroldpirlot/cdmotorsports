---
import { t, type Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);
---
<section class="band bandA">
  <div class="bg" data-parallax></div>
  <div class="t reveal">
    <div class="big">
      {T.bandA.line1}<br />
      {T.bandA.line2a}<em>{T.bandA.line2em}</em>
    </div>
  </div>
</section>
