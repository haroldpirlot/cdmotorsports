---
import { t, pathTo, type Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: T.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---
<section class="faq pad" id="faq">
  <div class="wrap">
    <div class="reveal" style="margin-bottom:40px">
      <div class="eyebrow" style="margin-bottom:16px">{T.faq.eyebrow}</div>
      <div class="big">{T.faq.title1}<br />{T.faq.title2}<em>{T.faq.titleEm}</em></div>
    </div>
    <div class="faq-list reveal">
      {T.faq.items.map((f) => (
        <details class="faq-item">
          <summary>
            <span>{f.q}</span>
            <span class="chev" aria-hidden="true">+</span>
          </summary>
          <p>{f.a}{f.link && (<> <a href={pathTo(f.link.href, lang)} class="faq-link">{f.link.label} →</a></>)}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

<style>
  .faq { }
  .faq-item {
    border-top: 1px solid var(--line);
    padding: 0;
  }
  .faq-item:last-child { border-bottom: 1px solid var(--line); }
  .faq-item summary {
    padding: 24px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    cursor: pointer;
    font-family: var(--disp);
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 400;
    color: var(--ink);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--sand); }
  .faq-item .chev {
    font-family: var(--disp);
    font-size: 24px;
    color: var(--sand);
    transition: transform .3s ease;
    line-height: 1;
    flex-shrink: 0;
  }
  .faq-item[open] .chev { transform: rotate(45deg); }
  .faq-item p {
    padding: 0 0 24px 0;
    color: #5f574b;
    font-size: 15px;
    line-height: 1.6;
    max-width: 780px;
  }
  .faq-link {
    color: var(--sand);
    font-family: var(--disp);
    text-decoration: none;
    white-space: nowrap;
    margin-left: 4px;
  }
  .faq-link:hover { color: var(--ink); }
</style>
