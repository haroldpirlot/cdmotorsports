---
import { getGalleryTiles } from '../../data/gallery';
import { t, pathTo, type Lang } from '../../i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);

const tiles = getGalleryTiles(lang).slice(0, 9);
---
<section class="gal pad" id="galerie">
  <div class="wrap">
    <div class="ghead reveal">
      <div>
        <div class="eyebrow" style="margin-bottom:16px">{T.gallery.eyebrow}</div>
        <div class="big">{T.gallery.titleStart}<em>{T.gallery.titleEm}</em></div>
      </div>
      <a href={pathTo('/galerie', lang)} class="more" aria-label={T.gallery.seeAllAria}>
        <span>{T.gallery.seeAll}</span>
        <svg viewBox="0 0 32 32" width="46" height="46" aria-hidden="true">
          <circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-width="1.2"/>
          <path d="M13 10 L20 16 L13 22 Z" fill="currentColor"/>
        </svg>
      </a>
    </div>
    <div class="ggrid reveal">
      {tiles.map((tile, i) => (
        <a class="gtile" href={tile.src} aria-label={tile.alt}>
          <picture>
            <source
              type="image/webp"
              srcset={`${tile.base}-800.webp 800w, ${tile.base}-1400.webp 1400w`}
              sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"
            />
            <img
              src={tile.src}
              alt={tile.alt}
              width="2000"
              height="1333"
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </picture>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ghead {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
    font-family: var(--sans);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 12px;
    font-weight: 700;
    transition: color .3s ease;
  }
  .more:hover { color: var(--sand); }
  .more svg { transition: transform .3s ease; }
  .more:hover svg { transform: translateX(4px); }

  .ggrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    grid-auto-rows: initial;
  }
  .gtile {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    display: block;
    aspect-ratio: 3 / 2;
    background: var(--cream);
  }
  .gtile picture,
  .gtile picture img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .8s cubic-bezier(.5, 0, .2, 1);
  }
  .gtile:hover picture img { transform: scale(1.05); }

  @media (max-width: 960px) {
    .ggrid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .ggrid { grid-template-columns: 1fr; }
  }
</style>
