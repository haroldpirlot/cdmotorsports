---
import { t, type Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);
---
<section class="philo pad">
  <div class="wrap">
    <div class="reveal" style="margin-bottom:30px">
      <div class="eyebrow" style="margin-bottom:16px">{T.philosophy.eyebrow}</div>
      <div class="big">
        {T.philosophy.big1}<br />
        {T.philosophy.big2}<em>{T.philosophy.big2em}</em>
      </div>
    </div>
    <div class="pgrid reveal">
      {T.philosophy.items.map((it) => (
        <div class="pitem">
          <div class="n">{it.n}</div>
          <h4>{it.h}</h4>
          <p>{it.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>
