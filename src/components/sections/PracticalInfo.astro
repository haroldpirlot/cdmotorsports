---
import { t, type Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);
---
<section class="infos pad" id="infos">
  <div class="wrap">
    <div class="reveal">
      <div class="eyebrow" style="margin-bottom:20px">{T.practical.eyebrow}</div>
      <div class="big" style="font-size:clamp(28px,3.8vw,48px)">
        {T.practical.big1}<br />
        <em>{T.practical.big2em}</em>
      </div>
      <ul class="ilist">
        {T.practical.points.map((p, i) => (
          <li><b>{String(i + 1).padStart(2, '0')}</b> {p}</li>
        ))}
      </ul>
    </div>
    <div class="im reveal">
      <img
        class="assistance-photo"
        src="/img/assitance.jpeg"
        alt={T.practical.assistanceAlt}
        width="1536"
        height="1024"
      />
    </div>
  </div>
  <div class="wrap prepwrap">
    <div class="prep reveal">
      <div>
        <h4>{T.practical.levelTitle}</h4>
        <p>{T.practical.levelP1}</p>
        <p>{T.practical.levelP2}</p>
      </div>
      <div>
        <h4>{T.practical.equipTitle}</h4>
        <ul>
          {T.practical.equipment.map((e) => <li>{e}</li>)}
        </ul>
      </div>
      <div>
        <h4>{T.practical.extrasTitle}</h4>
        <ul>
          {T.practical.extras.map((e) => <li>{e}</li>)}
        </ul>
      </div>
      <div>
        <h4>{T.practical.lodgingTitle}</h4>
        <p set:html={T.practical.lodgingP1}></p>
        <p>{T.practical.lodgingP2}</p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .infos .im img.assistance-photo {
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    object-fit: initial;
    display: block;
    border-radius: 2px;
  }
</style>
