---
// Placeholder de témoignages + lien TripAdvisor. Édouard remplira avec des
// avis réels ; l'URL TripAdvisor sera à mettre à jour quand la page sera
// créée. Note globale/nombre d'avis sont provisoires.
const reviews = [
  {
    name: '[Prénom N.]',
    country: '[Belgique]',
    raid: 'Odyssée du Sud',
    text: "Six jours dans le sud marocain avec une équipe au petit soin. Un raid intense, humain, à l'écoute de chacun. Je repars avec une envie folle d'y retourner.",
  },
  {
    name: '[Prénom N.]',
    country: '[France]',
    raid: "Boucle de l'Anti-Atlas",
    text: "Édouard connaît chaque piste comme sa poche. Le rythme colle au niveau du groupe, les bivouacs sont soignés, la mécanique est carrée. Une organisation impeccable.",
  },
  {
    name: '[Prénom N.]',
    country: '[Suisse]',
    raid: 'Cap Merzouga',
    text: "Passer par Merzouga en KOVE 450 Rally, avec l'assistance qui suit derrière, c'est vivre le rallye-raid de l'intérieur. Une expérience qui dépasse la simple sortie moto.",
  },
];

const tripAdvisorUrl = '#'; // À remplacer par l'URL TripAdvisor CDM Motorsport
---
<section class="reviews pad" id="avis">
  <div class="wrap">
    <div class="reveal" style="margin-bottom:40px">
      <div class="eyebrow" style="margin-bottom:16px">Ils l'ont vécu</div>
      <div class="big">Ce qu'en disent nos <em>pilotes.</em></div>
    </div>

    <div class="rgrid reveal">
      {reviews.map((r) => (
        <article class="rcard">
          <div class="stars" aria-label="5 étoiles sur 5">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <p class="rtext">« {r.text} »</p>
          <div class="rmeta">
            <b>{r.name}</b>
            <span>{r.country} · {r.raid}</span>
          </div>
        </article>
      ))}
    </div>

    <div class="ta reveal">
      <div class="ta-inner">
        <div class="ta-badge">
          <span class="ta-owl" aria-hidden="true">◉◉</span>
          <span class="ta-name">Tripadvisor</span>
        </div>
        <div class="ta-note">
          <div class="ta-stars" aria-label="Note globale">
            <span>●</span><span>●</span><span>●</span><span>●</span><span>◐</span>
          </div>
          <div class="ta-txt">Note et avis à venir sur notre page Tripadvisor.</div>
        </div>
        <a href={tripAdvisorUrl} class="btn dark" target="_blank" rel="noopener">
          Voir les avis Tripadvisor
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews { background: var(--paper); }
  .rgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .rcard {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 26px 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .stars {
    color: #C8702A;
    font-size: 15px;
    letter-spacing: 3px;
    line-height: 1;
  }
  .rtext {
    font-family: var(--sans);
    color: #4c4438;
    font-size: 15px;
    line-height: 1.6;
    flex: 1;
    margin: 0;
  }
  .rmeta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 12px;
    color: var(--muted);
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .rmeta b {
    font-family: var(--disp);
    color: var(--ink);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: .3px;
  }

  .ta {
    margin-top: 40px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 22px 26px;
  }
  .ta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    flex-wrap: wrap;
  }
  .ta-badge {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ta-owl {
    color: #00AF87;
    font-size: 20px;
    letter-spacing: -3px;
  }
  .ta-name {
    font-family: var(--disp);
    font-size: 20px;
    color: var(--ink);
    letter-spacing: .3px;
  }
  .ta-note {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 12px;
    color: var(--muted);
  }
  .ta-stars {
    color: #00AF87;
    font-size: 14px;
    letter-spacing: 2px;
    line-height: 1;
  }
  .ta-txt {
    font-family: var(--sans);
    letter-spacing: .3px;
  }

  @media (max-width: 860px) {
    .rgrid { grid-template-columns: 1fr; }
    .ta-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
