---
import { t, pathTo, type Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);
---
<section class="about pad" id="apropos">
  <div class="wrap">
    <div class="im reveal">
      <img src="/img/gallery/gallery-07.jpg" alt={T.story.imageAlt} />
    </div>
    <div class="reveal">
      <div class="eyebrow" style="margin-bottom:20px">{T.story.eyebrow}</div>
      <div class="big" style="font-size:clamp(28px,3.8vw,48px)">
        {T.story.big1}<br />
        {T.story.big2a}<em>{T.story.big2em}</em>
      </div>
      <p>{T.story.body}</p>
      <a href={pathTo('/edouard-de-moor', lang)} class="sig sig-link">{T.story.sig}</a>
    </div>
  </div>
</section>
