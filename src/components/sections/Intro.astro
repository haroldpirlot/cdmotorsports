---
import { t, type Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);
---
<section class="intro pad">
  <div class="wrap">
    <div class="reveal">
      <div class="eyebrow" style="margin-bottom:24px">{T.intro.eyebrow}</div>
      <div class="big">
        {T.intro.big1}<br />
        {T.intro.big2}<br />
        <em>{T.intro.big3em}</em>
      </div>
    </div>
    <p class="reveal">{T.intro.body}</p>
  </div>
</section>
