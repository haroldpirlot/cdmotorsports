---
import { t, type Lang } from '../../i18n';

interface Props {
  gallery: string[];
  name: string;
  lang?: Lang;
}
const { gallery, name, lang = 'fr' } = Astro.props;
const T = t(lang);
const layout = ['s3 r2', 's3', 's3', 's2', 's2', 's2'];
const photoWord = lang === 'en' ? 'photo' : 'photo';
---
<section class="rgal pad">
  <div class="wrap">
    <div class="reveal" style="margin-bottom:30px">
      <div class="eyebrow" style="margin-bottom:16px">{T.raid.gallery.eyebrow}</div>
      <div class="big">{T.raid.gallery.titleStart}<em>{T.raid.gallery.titleEm}</em></div>
    </div>
    <div class="rgrid reveal">
      {gallery.slice(0, 6).map((src, i) => (
        <a class={layout[i]} href={src}>
          <img src={src} alt={`${name}, ${photoWord} ${i + 1}`} />
        </a>
      ))}
    </div>
  </div>
</section>
