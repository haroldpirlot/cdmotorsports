---
interface Stage {
  from: string;
  to: string;
  km: number;
  lodging: string;
}
interface Props {
  stages: Stage[];
}
const { stages } = Astro.props;
---
<section class="iti pad">
  <div class="wrap">
    <div class="reveal" style="margin-bottom:24px">
      <div class="eyebrow" style="margin-bottom:16px">Étape par étape</div>
      <div class="big">Le <em>déroulé</em></div>
    </div>
    <div class="reveal">
      {stages.map((s, i) => (
        <div class="day">
          <div class="d">Jour {i + 1}</div>
          <div>
            <h3>{s.from} → {s.to}</h3>
            <div class="meta">
              <span><b>{s.km} km</b></span>
              <span>Hébergement <b>{s.lodging}</b></span>
            </div>
          </div>
        </div>
      ))}
    </div>
    <p class="reveal" style="margin-top:16px;color:#8c8375;font-size:13px;font-style:italic">
      Terrains et hébergements précis à détailler avec CDMotorSport.
    </p>
  </div>
</section>
