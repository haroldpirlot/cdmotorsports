---
import { t, pathTo, type Lang } from '../../i18n';

interface Props {
  status?: 'live' | 'coming-soon';
  lang?: Lang;
}
const { status = 'live', lang = 'fr' } = Astro.props;
const T = t(lang);
const isComing = status === 'coming-soon';
---
<section class="cta pad">
  <div class="bg" style="background-image:url('/img/pin.jpg')"></div>
  <div class="wrap reveal">
    <div class="eyebrow" style="color:#e8c9a6;margin-bottom:16px">
      {isComing ? T.raid.cta.eyebrowComing : T.raid.cta.eyebrowLive}
    </div>
    <div class="big">
      {isComing ? (
        <>{T.raid.cta.titleComing1} <em>{T.raid.cta.titleComingEm}</em></>
      ) : (
        <>{T.raid.cta.titleLive1} <em>{T.raid.cta.titleLiveEm}</em></>
      )}
    </div>
    <p style="margin:16px 0 24px;color:#f0e6d8;max-width:620px">
      {isComing ? T.raid.cta.bodyComing : T.raid.cta.bodyLive}
    </p>
    <a href={pathTo(isComing ? '/#contact' : '/reserver', lang)} class="btn">
      {isComing ? T.raid.cta.buttonComing : T.raid.cta.buttonLive}
    </a>
  </div>
</section>
