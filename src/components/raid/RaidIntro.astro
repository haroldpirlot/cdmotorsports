---
import { t, type Lang } from '../../i18n';

interface Props {
  totalKm: number;
  highlights: string[];
  lang?: Lang;
}
const { totalKm, highlights, lang = 'fr' } = Astro.props;
const T = t(lang);
const fmtLocale = lang === 'en' ? 'en-US' : 'fr-FR';
const totalKmStr = totalKm.toLocaleString(fmtLocale);
---
<section class="rintro pad">
  <div class="wrap">
    <div class="reveal">
      <div class="eyebrow" style="margin-bottom:16px">{T.raid.intro.eyebrow}</div>
      <div class="big">{totalKmStr} km {lang === 'en' ? 'of' : 'de'} <em>rallye-raid</em></div>
      <div style="margin-top:20px">
        <slot />
      </div>
    </div>
    <div class="reveal">
      <div class="eyebrow" style="margin-bottom:10px">{T.raid.intro.highlightsTitle}</div>
      <ul class="forts">
        {highlights.map((h, i) => (
          <li><b>{String(i + 1).padStart(2, '0')}</b> {h}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
