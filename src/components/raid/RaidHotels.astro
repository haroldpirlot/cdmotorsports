---
import { t, type Lang } from '../../i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const T = t(lang);

const photos = [
  { src: '/img/hotels/hotel-01', alt: T.raid.hotels.photos[0].alt, small: false },
  { src: '/img/hotels/hotel-02', alt: T.raid.hotels.photos[1].alt, small: false },
  { src: '/img/hotels/hotel-03', alt: T.raid.hotels.photos[2].alt, small: false },
  { src: '/img/hotels/hotel-04', alt: T.raid.hotels.photos[3].alt, small: true  },
  { src: '/img/hotels/hotel-05', alt: T.raid.hotels.photos[4].alt, small: true  },
];
---
<section class="hotels pad">
  <div class="wrap">
    <div class="hotels-head reveal">
      <div class="eyebrow" style="margin-bottom:14px">{T.raid.hotels.eyebrow}</div>
      <h3>{T.raid.hotels.title}</h3>
      <p>{T.raid.hotels.body}</p>
    </div>
    <div class="hotels-grid reveal">
      {photos.map((p) => (
        <a
          href={`${p.src}.jpg`}
          class:list={['hotels-item', p.small ? 'small' : '']}
          aria-label={p.alt}
        >
          <img
            src={`${p.src}-800.webp`}
            srcset={`${p.src}-800.webp 800w, ${p.src}-1400.webp 1400w`}
            sizes="(max-width: 640px) 45vw, (max-width: 960px) 30vw, 25vw"
            alt={p.alt}
            loading="lazy"
            decoding="async"
          />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hotels { padding-top: clamp(40px, 6vw, 80px); padding-bottom: clamp(60px, 8vw, 100px); }
  .hotels-head { max-width: 720px; margin-bottom: 32px; }
  .hotels-head h3 {
    font-family: var(--disp);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(24px, 3vw, 34px);
    letter-spacing: -.5px;
    margin: 0 0 14px;
  }
  .hotels-head p {
    color: #5f574b;
    font-size: 16px;
    line-height: 1.55;
    max-width: 620px;
  }

  /* Grille : 3 grandes en haut, 2 petites centrées en bas (desktop) */
  .hotels-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 14px;
  }
  .hotels-item {
    display: block;
    overflow: hidden;
    border-radius: 4px;
    background: var(--cream);
    line-height: 0;
    grid-column: span 4;
    aspect-ratio: 4 / 3;
    cursor: pointer;
  }
  .hotels-item.small {
    aspect-ratio: 3 / 2;
  }
  /* Ligne 2 : les 2 "small" centrées, taille plus modeste */
  .hotels-item.small:nth-of-type(4) { grid-column: 4 / span 3; }
  .hotels-item.small:nth-of-type(5) { grid-column: 7 / span 3; }

  .hotels-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s cubic-bezier(.5, 0, .2, 1);
  }
  .hotels-item:hover img { transform: scale(1.05); }

  @media (max-width: 720px) {
    .hotels-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .hotels-item,
    .hotels-item.small,
    .hotels-item.small:nth-of-type(4),
    .hotels-item.small:nth-of-type(5) {
      grid-column: span 1;
      aspect-ratio: 4 / 3;
    }
    /* La 5e photo (nombre impair) prend toute la largeur en dernière ligne */
    .hotels-item:last-child:nth-child(odd) { grid-column: span 2; aspect-ratio: 16 / 9; }
  }
</style>
