---
import { getEntry } from 'astro:content';
import type { Lang } from '../../i18n';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;

const collection = lang === 'en' ? 'globalsEn' : 'globals';
const included = await getEntry(collection, 'included');
const excluded = await getEntry(collection, 'excluded');
---
<section class="incl pad">
  <div class="wrap">
    <div class="reveal">
      <h4>{included?.data.title}</h4>
      <ul>
        {included?.data.items?.map((i) => <li>{i}</li>)}
      </ul>
    </div>
    <div class="reveal">
      <h4>{excluded?.data.title}</h4>
      <ul>
        {excluded?.data.items?.map((i) => <li class="no">{i}</li>)}
      </ul>
    </div>
  </div>
</section>
