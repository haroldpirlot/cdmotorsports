---
import { t, type Lang } from '../../i18n';

interface Props {
  n: number;
  name: string;
  itin: string;
  days: number;
  hero: string;
  totalKm: number;
  pricePerPerson?: number;
  status?: 'live' | 'coming-soon';
  lang?: Lang;
}
const { n, name, itin, days, hero, totalKm, pricePerPerson, status = 'live', lang = 'fr' } = Astro.props;
const T = t(lang);
const departure = itin.split(' → ')[0];
const fmtLocale = lang === 'en' ? 'en-US' : 'fr-FR';
const totalKmStr = totalKm.toLocaleString(fmtLocale);
const priceStr = pricePerPerson
  ? pricePerPerson.toLocaleString(fmtLocale) + ' €'
  : null;
const isComing = status === 'coming-soon';
const raidLabel = lang === 'en' ? 'Raid' : 'Raid';
const daysLabel = T.raid.daysLabel;
const departureLabel = T.raid.departure;
---
<section class="rhero" style={`background-image:url('${hero}')`}>
  <div class="wrap c">
    <div class="k">{raidLabel} {n} · {days} {daysLabel}</div>
    {isComing && <div class="rhero-badge">{T.raid.badgeComing}</div>}
    <h1>{name}</h1>
    <div class="itin">{itin}</div>
    <div class="chips">
      <span class="chip"><b>{days} {daysLabel}</b></span>
      <span class="chip"><b>{totalKmStr} km</b></span>
      <span class="chip">{departureLabel} <b>{departure}</b></span>
      {priceStr ? (
        <span class="chip"><b>{priceStr}</b> {T.raid.perPerson}</span>
      ) : (
        <span class="chip">{T.raid.priceTbdLabel[0]}<b>{T.raid.priceTbdLabel[1]}</b></span>
      )}
    </div>
  </div>
</section>

<style>
  .rhero-badge {
    display: inline-block;
    margin: 12px 0 6px;
    background: rgba(20, 16, 8, .88);
    color: #f4c48b;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 2px;
    border: 1px solid rgba(244, 196, 139, .5);
  }
</style>
