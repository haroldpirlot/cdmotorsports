---
interface Props {
  prev: { slug: string; name: string };
  next: { slug: string; name: string };
}
const { prev, next } = Astro.props;
---
<!-- Flèches flottantes sur les bords, visibles pendant toute la lecture du raid -->
<div class="rside" aria-hidden="false">
  <a
    href={`/raids/${prev.slug}`}
    class="rside-arrow rside-arrow--prev"
    aria-label={`Raid précédent, ${prev.name}`}
    data-tip={prev.name}
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
      <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="rside-tip">{prev.name}</span>
  </a>
  <a
    href={`/raids/${next.slug}`}
    class="rside-arrow rside-arrow--next"
    aria-label={`Raid suivant, ${next.name}`}
    data-tip={next.name}
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
      <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="rside-tip">{next.name}</span>
  </a>
</div>

<section class="rnav">
  <div class="wrap">
    <a href={`/raids/${prev.slug}`}>← {prev.name}</a>
    <a href="/#raids">Tous les raids</a>
    <a href={`/raids/${next.slug}`}>{next.name} →</a>
  </div>
</section>

<style>
  .rside {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 150;
  }
  .rside-arrow {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(20, 16, 8, .55);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, .35);
    backdrop-filter: blur(8px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    text-decoration: none;
    transition: background .2s ease, border-color .2s ease, transform .2s ease;
  }
  .rside-arrow--prev { left: 18px; }
  .rside-arrow--next { right: 18px; }
  .rside-arrow:hover,
  .rside-arrow:focus-visible {
    background: #B4642C;
    border-color: #fff;
    transform: translateY(-50%) scale(1.05);
  }
  .rside-arrow:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  .rside-tip {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(20, 16, 8, .92);
    color: #fff;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .6px;
    text-transform: uppercase;
    padding: 8px 12px;
    border-radius: 2px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s ease, transform .2s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, .28);
  }
  .rside-arrow--prev .rside-tip {
    left: calc(100% + 12px);
    transform: translateY(-50%) translateX(-6px);
  }
  .rside-arrow--next .rside-tip {
    right: calc(100% + 12px);
    transform: translateY(-50%) translateX(6px);
  }
  .rside-arrow:hover .rside-tip,
  .rside-arrow:focus-visible .rside-tip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @media (max-width: 720px) {
    .rside-arrow { width: 40px; height: 40px; }
    .rside-arrow--prev { left: 10px; }
    .rside-arrow--next { right: 10px; }
    /* Sur mobile, on masque le tooltip permanent et laisse juste la flèche
       (aria-label reste lu par les lecteurs d'écran, texte visible dans la barre nav du bas) */
    .rside-tip { display: none; }
  }
</style>

<script>
  // Swipe horizontal (mobile) pour naviguer entre raids
  (function () {
    const prev = document.querySelector<HTMLAnchorElement>('.rside-arrow--prev');
    const next = document.querySelector<HTMLAnchorElement>('.rside-arrow--next');
    if (!prev || !next) return;
    let sx = 0, sy = 0, moved = false;
    const THRESHOLD = 80; // px
    document.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      sx = t.clientX; sy = t.clientY; moved = false;
    }, { passive: true });
    document.addEventListener('touchmove', (e) => {
      const t = e.touches[0];
      if (Math.abs(t.clientX - sx) > 10 || Math.abs(t.clientY - sy) > 10) moved = true;
    }, { passive: true });
    document.addEventListener('touchend', (e) => {
      if (!moved) return;
      const t = e.changedTouches[0];
      const dx = t.clientX - sx;
      const dy = t.clientY - sy;
      // Swipe horizontal net (dx large, dy faible)
      if (Math.abs(dx) < THRESHOLD || Math.abs(dy) > Math.abs(dx) * 0.6) return;
      // Éviter les swipes dans la carte Leaflet, la galerie ou la barre marquee
      const target = e.target as HTMLElement;
      if (target.closest('.raidmap, .ggrid, .marq, .rtrack, .galerie, .lightbox, #lb')) return;
      if (dx < 0) location.href = next.getAttribute('href')!;
      else location.href = prev.getAttribute('href')!;
    }, { passive: true });
  })();
</script>
